cabal-version: 3.0
name:          midgard-offchain
version:       0.1.0.0

common lang
  ghc-options:
    -Wall -Wcompat -Wincomplete-uni-patterns -Wno-unused-do-bind
    -Wno-partial-type-signatures -Wno-missing-import-lists
    -Wmissing-export-lists -Wincomplete-record-updates
    -Wmissing-deriving-strategies -Wno-name-shadowing -Wunused-foralls
    -Wno-unused-packages -Wno-missing-local-signatures
    -Wno-implicit-prelude -fprint-explicit-foralls
    -fprint-explicit-kinds -Wunused-imports
    -Wno-missing-safe-haskell-mode -Wno-missing-kind-signatures
    -Wno-operator-whitespace -Wno-unsafe
    -Wno-prepositive-qualified-module -Wno-partial-fields
    -Wno-monomorphism-restriction -Wno-missed-specialisations
    -Wno-all-missed-specializations -Wno-unused-packages

  default-extensions:
    BangPatterns
    BinaryLiterals
    ConstrainedClassMethods
    ConstraintKinds
    DataKinds
    DeriveAnyClass
    DeriveDataTypeable
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveLift
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    DoAndIfThenElse
    DuplicateRecordFields
    EmptyCase
    EmptyDataDecls
    EmptyDataDeriving
    ExistentialQuantification
    ExplicitForAll
    FlexibleContexts
    FlexibleInstances
    ForeignFunctionInterface
    GADTSyntax
    GeneralisedNewtypeDeriving
    HexFloatLiterals
    ImplicitPrelude
    ImportQualifiedPost
    InstanceSigs
    KindSignatures
    LambdaCase
    MonomorphismRestriction
    MultiParamTypeClasses
    NamedFieldPuns
    NamedWildCards
    NoMonomorphismRestriction
    NoStarIsType
    NumericUnderscores
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    PackageImports
    PartialTypeSignatures
    PatternGuards
    PolyKinds
    PostfixOperators
    QualifiedDo
    RankNTypes
    RecordWildCards
    RelaxedPolyRec
    ScopedTypeVariables
    StandaloneDeriving
    StandaloneKindSignatures
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    TypeSynonymInstances
    UndecidableInstances
    ViewPatterns

  default-language:   GHC2021

common dependencies
  build-depends:
    , base
    , base16-bytestring
    , bytestring
    , cardano-api        ==10.21.0.0
    , containers
    , convex-base
    , convex-mockchain
    , convex-optics
    , mtl
    , plutus-ledger-api
    , plutus-tx
    , ply-core
    , text
    , transformers

library
  import:          lang, dependencies
  exposed-modules:
    Midgard.Constants
    Midgard.Contracts.ActiveOperators
    Midgard.Contracts.Init
    Midgard.Contracts.RegisteredOperators
    Midgard.Contracts.RetiredOperators
    Midgard.Contracts.Scheduler
    Midgard.Contracts.Utils
    Midgard.Scripts
    Midgard.ScriptUtils
    Midgard.Types.ActiveOperators
    Midgard.Types.HubOracle
    Midgard.Types.LinkedList
    Midgard.Types.OperatorDirectory
    Midgard.Types.RegisteredOperators
    Midgard.Types.RetiredOperators
    Midgard.Types.Scheduler

  hs-source-dirs:  src
  build-depends:
    , aeson
    , cardano-ledger-core
    , lens
    , plutus-core
    , time
    , yaml

executable midgard-node
  import:         lang, dependencies
  main-is:        Main.hs
  hs-source-dirs: node/app
  build-depends:  midgard-node-lib

library midgard-node-lib
  import:          lang, dependencies
  hs-source-dirs:  node/src
  exposed-modules:
    Midgard.Node.API
    Midgard.Node.API.Types
    Midgard.Node.App
    Midgard.Node.Config
    Midgard.Node.DB.AddressHistory
    Midgard.Node.DB.Blocks
    Midgard.Node.DB.Deposits
    Midgard.Node.DB.Health
    Midgard.Node.DB.Hex
    Midgard.Node.DB.MempoolLedger
    Midgard.Node.DB.Migration
    Midgard.Node.DB.Pool
    Midgard.Node.DB.Transactions
    Midgard.Node.DB.TxStatus
    Midgard.Node.DB.Types
    Midgard.Node.Env
    Midgard.Node.Migrations
    Midgard.Node.Server
    Midgard.Node.TxOutRef

  build-depends:
    , aeson
    , cryptohash-sha256
    , directory
    , filepath
    , midgard-offchain
    , monad-logger
    , persistent
    , persistent-postgresql
    , postgresql-simple
    , resource-pool
    , servant
    , servant-server
    , time
    , unliftio-core
    , wai
    , warp
    , yaml

test-suite mockchain-tests
  import:         lang, dependencies
  type:           exitcode-stdio-1.0
  main-is:        Spec.hs
  hs-source-dirs: tests
  other-modules:
    Spec.Operators
    Spec.Scheduler
    Spec.Types
    Spec.Utils

  build-depends:
    , convex-coin-selection
    , convex-devnet
    , convex-wallet
    , midgard-offchain
    , tasty
    , tasty-hunit
    , tasty-quickcheck

test-suite node-db-tests
  import:         lang, dependencies
  type:           exitcode-stdio-1.0
  main-is:        Spec.hs
  hs-source-dirs: node/tests
  other-modules:  Spec.Node.DB
  build-depends:
    , directory
    , midgard-node-lib
    , monad-logger
    , persistent
    , persistent-sqlite
    , resource-pool
    , tasty
    , tasty-hunit
    , time
