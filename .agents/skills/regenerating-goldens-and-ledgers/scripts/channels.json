    "@golden-channel": ["demo/midgard-core/scripts/golden-channel.mjs"],
    "@compiler-pin": [
      "onchain/aiken/scripts/pinned-compiler.mjs",
      ".github/workflows/aiken-ci.yml",
      ".github/workflows/midgard-node-ci.yml"
    ],
    "@blueprint": [
      "onchain/aiken/lib/**/*.ak",
      "onchain/aiken/validators/**/*.ak",
      "onchain/aiken/env/*.ak",
      "onchain/aiken/aiken.toml",
      "onchain/aiken/aiken.lock",
      "@compiler-pin"
    ],
    "@blueprint-exclude": ["onchain/aiken/**/*.test.ak"],
    "@exec-ledger-harness": [
      "onchain/aiken/scripts/exec-ledger-measure-v1.mjs",
      "onchain/aiken/scripts/exec-ledger-within-basis-v1.mjs",
      "onchain/aiken/scripts/run-focused-check.mjs",
      "onchain/aiken/env/*.ak",
      "onchain/aiken/aiken.toml",
      "onchain/aiken/aiken.lock",
      "@compiler-pin"
    ]
  },
