{
  "note": "TEMPLATE for §13.4 evidence bindings. Repository form binds a committed evidence-path file; external form binds an immutable durable URI. Unverifiable evidence is OPEN, never PASS.",
  "repositoryBinding": {
    "path": "docs/exec-plans/evidence/<artifact>.json",
    "sha256": "<64-hex>",
    "byteSize": 12345,
    "mediaType": "application/json",
    "redaction": { "status": "PASS", "scanner": "verify-canonical-v1-goal-static-policy.mjs" },
    "reproduction": { "command": "pnpm --dir demo run goal:verify:capability", "deterministic": true },
    "retention": "repository history",
    "access": "repository readers",
    "status": "BOUND"
  },
  "externalBinding": {
    "uri": "<immutable durable URI>",
    "sha256": "<64-hex>",
    "byteSize": 123456789,
    "mediaType": "application/x-ndjson",
    "redaction": { "status": "PASS", "scanner": "midgard-secret-scanned-log-v1" },
    "reproduction": { "command": "NOT_REPRODUCIBLE", "reason": "live testnet capture at <chain point>" },
    "retention": "until Goal review completes; >= DA retention window (15 days)",
    "access": "<who can fetch it>",
    "status": "BOUND"
  }
}
