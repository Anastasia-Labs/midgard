{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midgard.example/schemas/canonical-v1-goal-closure-v1.schema.json",
  "title": "Midgard canonical V1 Goal closure manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "generatedAt",
    "revision",
    "evidencePaths",
    "dirtyBaseline",
    "toolchain",
    "parameterSnapshot",
    "targetTestnetParameterSnapshot",
    "blueprint",
    "closureArtifacts",
    "validatorSet",
    "deployment",
    "fixtureSets",
    "commandResults",
    "acceptanceCriteria",
    "residualBlockers",
    "regenerationRecords",
    "secrets",
    "release"
  ],
  "properties": {
    "schema": {
      "const": "midgard.canonical-v1-goal-closure.v1"
    },
    "version": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "headCommit", "releaseCommit", "worktree"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "headCommit": { "$ref": "#/$defs/commit" },
        "releaseCommit": {
          "oneOf": [{ "$ref": "#/$defs/commit" }, { "type": "null" }]
        },
        "worktree": {
          "enum": ["IN_PROGRESS", "BASELINE_RELATIVE_CLEAN"]
        }
      }
    },
    "evidencePaths": {
      "description": "GOAL_SPEC §0.2 declared evidence path classes, in spec order. The decoder requires this to equal the pinned DECLARED_EVIDENCE_PATHS exactly; a manifest cannot widen the surface an evidence commit may touch.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/evidencePath" }
    },
    "dirtyBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledgerPath", "startingRevision", "protectedPaths"],
      "properties": {
        "ledgerPath": { "type": "string", "minLength": 1 },
        "startingRevision": { "$ref": "#/$defs/commit" },
        "protectedPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/protectedPath" }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm", "aiken", "git", "nix", "make", "docker"],
      "properties": {
        "node": { "$ref": "#/$defs/tool" },
        "pnpm": { "$ref": "#/$defs/tool" },
        "aiken": { "$ref": "#/$defs/tool" },
        "git": { "$ref": "#/$defs/tool" },
        "nix": { "$ref": "#/$defs/tool" },
        "make": { "$ref": "#/$defs/tool" },
        "docker": { "$ref": "#/$defs/tool" }
      }
    },
    "parameterSnapshot": {
      "description": "C70 trusted Cardano mainnet effective/pending parameter snapshot: the capability floor (GOAL_SPEC §13.3, §3.1.10).",
      "$ref": "#/$defs/parameterSnapshotBinding"
    },
    "targetTestnetParameterSnapshot": {
      "description": "C70 target-testnet effective/pending parameter snapshot the deployment is validated against. Must be a different path — and a different parameter set — from parameterSnapshot.",
      "$ref": "#/$defs/parameterSnapshotBinding"
    },
    "blueprint": { "$ref": "#/$defs/fileBinding" },
    "closureArtifacts": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/fileBinding" }
    },
    "validatorSet": { "$ref": "#/$defs/identityBinding" },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "identity", "status", "evidence"],
      "properties": {
        "network": { "const": "preprod" },
        "identity": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "status": { "enum": ["OPEN", "BOUND"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileBinding" }
        }
      }
    },
    "fixtureSets": {
      "type": "array",
      "items": { "$ref": "#/$defs/fileBinding" }
    },
    "commandResults": {
      "type": "array",
      "items": { "$ref": "#/$defs/commandResult" }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 35,
      "maxItems": 35,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "residualBlockers": {
      "description": "GOAL_SPEC §9.5 named residual launch blockers. An empty array means none is claimed; every entry must also be recorded in root public_testnet_readiness.md, and ownerAccepted=true requires bound evidence of that acceptance.",
      "type": "array",
      "items": { "$ref": "#/$defs/residualBlocker" }
    },
    "regenerationRecords": {
      "description": "GOAL_SPEC §2.4/§13.4: how to regenerate artifacts too large or transient to commit. An empty array means everything needed is committed. The verifier proves each outputPath is genuinely untracked.",
      "type": "array",
      "items": { "$ref": "#/$defs/regenerationRecord" }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanStatus", "evidence"],
      "properties": {
        "scanStatus": { "enum": ["OPEN", "PASS"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileBinding" }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "digestAlgorithm", "digest"],
      "properties": {
        "status": { "enum": ["OPEN", "BOUND"] },
        "digestAlgorithm": { "const": "sha256" },
        "digest": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "version"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "status": { "enum": ["OPEN", "BOUND"] }
      }
    },
    "identityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "status", "evidence"],
      "properties": {
        "identity": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "status": { "enum": ["OPEN", "BOUND"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileBinding" }
        }
      }
    },
    "evidencePath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": {
          "description": "FILE matches that exact repo-relative path; TREE matches everything beneath the directory.",
          "enum": ["FILE", "TREE"]
        }
      }
    },
    "parameterSnapshotBinding": {
      "description": "A C70 parameter snapshot bound by path plus the identity of the parameter set it captured. snapshotDigest is SHA-256 over the snapshot's parsed values with sorted keys — stable under reformatting, and NOT the tracked-file byte hash removed by the §13.4 owner amendment. Null exactly while status is OPEN, so release fails closed until C70 delivers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "snapshotDigest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "status": { "enum": ["OPEN", "BOUND"] },
        "snapshotDigest": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    },
    "regenerationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "command", "outputPath", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "outputPath": { "type": "string", "minLength": 1 },
        "reason": {
          "enum": ["TOO_LARGE", "TOO_TRANSIENT", "UNSAFE_TO_COMMIT"]
        }
      }
    },
    "protectedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "disposition"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "disposition": {
          "enum": [
            "PROTECTED_EXACT_BASELINE",
            "PROTECTED_ACCEPTED_EXTERNAL_DRIFT",
            "PROTECTED_EXTERNAL_UNTRACKED"
          ]
        }
      }
    },
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "exitCode",
        "testCount",
        "durationMs",
        "revision",
        "artifactIdentity",
        "finishedAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "exitCode": { "type": "integer", "minimum": 0 },
        "testCount": {
          "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "durationMs": { "type": "integer", "minimum": 0 },
        "revision": { "$ref": "#/$defs/commit" },
        "artifactIdentity": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "finishedAt": { "type": "string", "format": "date-time" },
        "transactionHashes": {
          "description": "Exact Cardano transaction identities this command submitted (GOAL_SPEC §13.3, F41). Present only for state-changing live acceptance commands; omit the key rather than recording an empty list.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "residualBlocker": {
      "description": "A GOAL_SPEC §9.5 named residual launch blocker. acceptedBy/acceptedAt are non-null exactly when ownerAccepted is true, making the acceptance an auditable record rather than a bare flag. The verifier additionally requires the id to be named in root public_testnet_readiness.md — §9.5 forbids silence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "ownerAccepted",
        "acceptedBy",
        "acceptedAt",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "ownerAccepted": { "type": "boolean" },
        "acceptedBy": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "acceptedAt": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileBinding" }
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-(?:0[0-3]|[CQW].+|X1[0-3])$"
        },
        "status": { "enum": ["OPEN", "PASS"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileBinding" }
        }
      }
    }
  }
}
