const state_wrong_stride_cbor: ByteArray =
  #"d8799f582022222222222222222222222222222222222222222222222222222222222222220003ff"

fn state_wrong_stride_value() -> State {
  State {
    bad_tx_id: #"2222222222222222222222222222222222222222222222222222222222222222",
    field_index: 0,
    verdict: 3,
  }
}

/// State / `state_wrong_stride`: decode the TypeScript
/// producer's bytes, then re-serialise what came back.
test committed_field_shape_golden_state_wrong_stride_round_trips() {
  expect Some(decoded_data) = cbor.deserialise(state_wrong_stride_cbor)
  expect decoded: State = decoded_data
  let rebuilt: Data = state_wrong_stride_value()
  and {
    decoded == state_wrong_stride_value(),
    cbor.serialise(rebuilt) == state_wrong_stride_cbor,
  }
}

