test size_balanced_lucid_midgard_native_tx_decodes() {
  let tx_cbor = size_balanced_tx_cbor
  let compact_cbor = size_balanced_compact_cbor
  let tx_id = size_balanced_tx_id
  let decoded = decode_midgard_transaction_v1(tx_cbor)
  let compact = midgard_transaction_to_compact(decoded)
  let witness_compact = midgard_transaction_witness_set_to_compact(
    decoded.witness_set,
  )
  let compact_from_cbor = decode_native_tx_compact_v1(compact_cbor)
  let verified = verify_native_tx_compact_v1(
    tx_id,
    compact_from_cbor,
    compact_cbor,
  )
  let verified_from_cbor = verify_native_tx_compact_cbor_v1(tx_id, compact_cbor)
  let decoded_spend_inputs = decode_midgard_tx_inputs_preimage_cbor(
    size_balanced_spend_inputs_preimage_cbor,
  )
  let decoded_reference_inputs = decode_midgard_tx_inputs_preimage_cbor(
    size_balanced_reference_inputs_preimage_cbor,
  )
  let decoded_outputs = decode_midgard_tx_outputs_preimage_cbor(
    size_balanced_outputs_preimage_cbor,
  )
  let decoded_required_observers = decode_midgard_tx_byte_list_preimage_cbor(
    size_balanced_required_observers_preimage_cbor,
  )
  let decoded_required_signers = decode_midgard_tx_byte_list_preimage_cbor(
    size_balanced_required_signers_preimage_cbor,
  )
  let decoded_mint = decode_midgard_tx_mint_preimage_cbor(
    size_balanced_mint_preimage_cbor,
  )
  let decoded_addr_wits = decode_midgard_tx_address_witnesses_preimage_cbor(
    size_balanced_addr_wits_preimage_cbor,
  )
  let decoded_script_wits = decode_midgard_tx_script_witnesses_preimage_cbor(
    size_balanced_script_wits_preimage_cbor,
  )
  let decoded_redeemer_wits = decode_midgard_tx_redeemer_witnesses_preimage_cbor(
    size_balanced_redeemer_wits_preimage_cbor,
  )

  and {
    bytearray.length(tx_cbor) == size_balanced_full_tx_cbor_bytes,
    bytearray.length(compact_cbor) == size_balanced_compact_tx_cbor_bytes,
    size_balanced_full_tx_cbor_bytes >= size_balanced_target_tx_cbor_bytes - 256,
    size_balanced_full_tx_cbor_bytes <= size_balanced_target_tx_cbor_bytes + 256,
    verified_from_cbor == verified,
    compact == compact_from_cbor,
    verified.tx_compact == compact_from_cbor,
    encode_midgard_transaction_v1(decoded) == tx_cbor,
    encode_native_tx_compact_v1(compact) == compact_cbor,
    native_tx_id_for_version(
      decoded.version,
      encode_native_tx_body_compact(compact.body),
    ) == tx_id,
    decoded.body.fee == size_balanced_fee,
    decoded.body.fee <= 10000000,
    list.length(decoded.body.inputs) == 48,
    list.length(decoded.body.reference_inputs) == 32,
    list.length(decoded.body.outputs) == 48,
    list.length(decoded.body.required_observers) == 18,
    list.length(decoded.body.required_signers) == 17,
    list.length(builtin.un_map_data(decoded.body.mint)) == 24,
    list.length(decoded.witness_set.addr_tx_wits) == 17,
    list.length(decoded.witness_set.script_tx_wits) == 68,
    list.length(decoded.witness_set.redeemer_tx_wits) == 68,
    list.length(decoded_spend_inputs) == 48,
    list.length(decoded_reference_inputs) == 32,
    list.length(decoded_outputs) == 48,
    list.length(decoded_required_observers) == 18,
    list.length(decoded_required_signers) == 17,
    list.length(builtin.un_map_data(decoded_mint)) == 24,
    list.length(decoded_addr_wits) == 17,
    list.length(decoded_script_wits) == 68,
    list.length(decoded_redeemer_wits) == 68,
    compact.body.spend_inputs_hash == size_balanced_spend_inputs_hash,
    compact.body.reference_inputs_hash == size_balanced_reference_inputs_hash,
    compact.body.outputs_hash == size_balanced_outputs_hash,
    compact.body.required_observers_hash == size_balanced_required_observers_hash,
    compact.body.required_signers_hash == size_balanced_required_signers_hash,
    compact.body.mint_hash == size_balanced_mint_hash,
    witness_compact.addr_tx_wits_hash == size_balanced_addr_tx_wits_hash,
    witness_compact.script_tx_wits_hash == size_balanced_script_tx_wits_hash,
    witness_compact.redeemer_tx_wits_hash == size_balanced_redeemer_tx_wits_hash,
    compact.witness_set_hash == size_balanced_witness_set_hash,
  }
}
