fn redeemer_purpose_tag(purpose: MidgardRedeemerPurpose) -> Int {
  when purpose is {
    SpendRedeemer -> 0
    MintRedeemer -> 1
    RewardRedeemer -> 3
    ReceiveRedeemer -> 6
    _ -> -1
  }
}

fn redeemer_pointer_tags(
  redeemers: List<MidgardRedeemerWitness>,
) -> List<Pair<Int, Int>> {
  redeemers
    |> list.map(
        fn(redeemer) {
          Pair(redeemer_purpose_tag(redeemer.purpose), redeemer.index)
        },
      )
}

