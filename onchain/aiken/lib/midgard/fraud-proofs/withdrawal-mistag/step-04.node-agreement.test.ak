//// Node-agreement vectors for the withdrawal payability rule.
////
//// Each `agrees_<case>` test judges a withdrawal body (raw CBOR, as the
//// order carries it) and the withdrawn output's Cardano value size with
//// step-04's `payout_is_exactly_payable_v1`, and pins the verdict; a `fail`
//// case is a body step-04 refuses outright. The TypeScript twin,
//// demo/midgard-fault-proofs/tests/withdrawal-mistag.payability-agreement.test.ts,
//// rebuilds each case's body and output, checks these bytes and sizes are
//// that case's, and checks that the SDK's `withdrawalMistagPayable` and the
//// node's `classifyWithdrawalFromLedger` reach the same verdict.

use aiken/cbor
use midgard/fraud_proofs/withdrawal_mistag/step_04
use midgard/ledger_state

fn chain_payable(body_cbor: ByteArray, cardano_value_size: Int) -> Bool {
  expect Some(data) = cbor.deserialise(body_cbor)
  expect body: ledger_state.WithdrawalBody = data
  step_04.payout_is_exactly_payable_v1(body, cardano_value_size)
}

test agrees_ada_exact_minimum() {
  chain_payable(
    #"d8799fd8799f5820abababababababababababababababababababababababababababababababab00ff581c2b218f09113f8c3900e461c3ea9985152b27c410dbc2e1d111eb3262bf40bf401a000d165affffd8799fd8799f581c2b218f09113f8c3900e461c3ea9985152b27c410dbc2e1d111eb3262ffd87a80ffd87980ff",
    5,
  ) == True
}

test agrees_ada_one_below_minimum() {
  chain_payable(
    #"d8799fd8799f5820abababababababababababababababababababababababababababababababab00ff581c2b218f09113f8c3900e461c3ea9985152b27c410dbc2e1d111eb3262bf40bf401a000d1659ffffd8799fd8799f581c2b218f09113f8c3900e461c3ea9985152b27c410dbc2e1d111eb3262ffd87a80ffd87980ff",
    5,
  ) == False
}

test agrees_token_exact_minimum() {
  chain_payable(
    #"",
    41,
  ) == True
}

test agrees_token_one_below_minimum() {
  chain_payable(
    #"",
    41,
  ) == False
}

test agrees_inline_stake_datum_hash_exact_minimum() {
  chain_payable(
    #"",
    5,
  ) == True
}

test agrees_inline_stake_datum_hash_one_below_minimum() {
  chain_payable(
    #"",
    5,
  ) == False
}

test agrees_pointer_exact_minimum() {
  chain_payable(
    #"d8799fd8799f5820abababababababababababababababababababababababababababababababab00ff581c2b218f09113f8c3900e461c3ea9985152b27c410dbc2e1d111eb3262bf40bf401a000dbeb6ffffd8799fd8799f581c2b218f09113f8c3900e461c3ea9985152b27c410dbc2e1d111eb3262ffd8799fd87a9f1b000001000000000019400000ffffffd87980ff",
    5,
  ) == True
}

