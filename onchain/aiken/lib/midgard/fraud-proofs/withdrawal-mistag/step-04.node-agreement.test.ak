test agrees_value_size_at_limit() {
  chain_payable(
    #"",
    5_000,
  ) == True
}

test agrees_value_size_above_limit() {
  chain_payable(
    #"",
    5_001,
  ) == False
}

test agrees_short_datum_hash() fail {
  chain_payable(
    #"",
    5,
  )
}
