      },
    ) == #"84000043d87980821903e81907d0",
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: MintRedeemer,
        index: 1,
        redeemer_cbor: #"d87980",
        execution_units: MidgardExecutionUnits { memory: 1001, steps: 2001 },
      },
    ) == #"84010143d87980821903e91907d1",
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: CertRedeemer,
        index: 2,
        redeemer_cbor: #"d87980",
        execution_units: MidgardExecutionUnits { memory: 1002, steps: 2002 },
      },
    ) == #"84020243d87980821903ea1907d2",
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: RewardRedeemer,
        index: 3,
        redeemer_cbor: #"d87980",
        execution_units: MidgardExecutionUnits { memory: 1003, steps: 2003 },
      },
    ) == #"84030343d87980821903eb1907d3",
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: VoteRedeemer,
        index: 4,
        redeemer_cbor: #"d87980",
        execution_units: MidgardExecutionUnits { memory: 1004, steps: 2004 },
      },
    ) == #"84040443d87980821903ec1907d4",
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: ProposeRedeemer,
        index: 5,
        redeemer_cbor: #"d87980",
        execution_units: MidgardExecutionUnits { memory: 1005, steps: 2005 },
      },
    ) == #"84050543d87980821903ed1907d5",
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: ReceiveRedeemer,
        index: 6,
        redeemer_cbor: #"d87980",
        execution_units: MidgardExecutionUnits { memory: 1006, steps: 2006 },
      },
    ) == #"84060643d87980821903ee1907d6",
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: SpendRedeemer,
        index: 0,
        redeemer_cbor: #"d87980",
        execution_units: MidgardExecutionUnits { memory: 0, steps: 23 },
      },
    ) == #"84000043d87980820017",
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: MintRedeemer,
        index: 23,
        redeemer_cbor: #"43d87980",
        execution_units: MidgardExecutionUnits { memory: 24, steps: 255 },
      },
    ) == #"8401174443d8798082181818ff",
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: RewardRedeemer,
        index: 24,
        redeemer_cbor: #"1bffffffffffffffff",
        execution_units: MidgardExecutionUnits { memory: 256, steps: 65535 },
      },
    ) == #"84031818491bffffffffffffffff8219010019ffff",
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: ReceiveRedeemer,
        index: 65535,
        redeemer_cbor: #"d8668218809f00ff",
        execution_units: MidgardExecutionUnits {
          memory: 65536,
          steps: 4294967296,
        },
      },
    ) == #"840619ffff48d8668218809f00ff821a000100001b0000000100000000",
  }
}

// ---------------------------------------------------------------------------
// §5.3 width assertions — the negatives that bite
// ---------------------------------------------------------------------------

/// Fields 3/4 have no interior CBOR — the item *is* the raw 28-byte hash, so
/// the width assertion inside `encode_hash28_list_preimage` is the only thing
/// fixing the stride at 30.
test golden_f3_f4_item_width_rejects_27_bytes() fail {
  bytearray.length(
    encode_hash28_list_preimage(
      [#"222930373e454c535a61686f767d848b9299a0a7aeb5bcc3cad1d8"],
    ),
  ) >= 0
}

/// The same assertion from the other side.
test golden_f3_f4_item_width_rejects_29_bytes() fail {
  bytearray.length(
    encode_hash28_list_preimage(
      [#"222930373e454c535a61686f767d848b9299a0a7aeb5bcc3cad1d8dfe6"],
    ),
  ) >= 0
}

/// Fields 0/1: a 31-byte tx id would make the item 37 bytes and silently
/// break stride-40 arithmetic for every item after it.
test golden_f0_f1_item_rejects_a_short_tx_id() fail {
  bytearray.length(
    encode_midgard_tx_input(
      MidgardTxInput {
        tx_id: #"222930373e454c535a61686f767d848b9299a0a7aeb5bcc3cad1d8dfe6edf4",
        output_index: 0,
      },
    ),
  ) >= 0
}

/// Fields 0/1, the decode side of the same width. `59 0020` is a second,
/// wider spelling of "32 bytes" that `decode_definite_bytes_at` will read,
/// so a 39-byte item would otherwise decode to the *same* out-ref as the
/// canonical 38-byte one — two trie keys naming one out-ref. The exact-38
/// guard in `decode_midgard_tx_input_cbor` is what rejects it, and its
/// TypeScript twin `decodeMidgardSpendInputItemV1` rejects it on width too.
test golden_f0_f1_decoder_rejects_a_non_minimal_tx_id_header() fail {
  bytearray.length(
    encode_midgard_tx_input(
      decode_midgard_tx_input_cbor(
        #"82590020222930373e454c535a61686f767d848b9299a0a7aeb5bcc3cad1d8dfe6edf4fb190002",
      ),
    ),
  ) >= 0
}

/// Field 7 is structurally fixed at 101 bytes: 32-byte key, 64-byte signature.
test golden_f7_item_rejects_a_short_verification_key() fail {
  bytearray.length(
    encode_midgard_address_witness(
      MidgardAddressWitness {
        verification_key: #"222930373e454c535a61686f767d848b9299a0a7aeb5bcc3cad1d8dfe6edf4",
        signature: #"41484f565d646b727980878e959ca3aab1b8bfc6cdd4dbe2e9f0f7fe050c131a21282f363d444b525960676e757c838a91989fa6adb4bbc2c9d0d7dee5ecf3fa",
      },
    ),
  ) >= 0
}

/// The other half of field 7's width.
test golden_f7_item_rejects_a_short_signature() fail {
  bytearray.length(
    encode_midgard_address_witness(
      MidgardAddressWitness {
        verification_key: #"222930373e454c535a61686f767d848b9299a0a7aeb5bcc3cad1d8dfe6edf4fb",
        signature: #"41484f565d646b727980878e959ca3aab1b8bfc6cdd4dbe2e9f0f7fe050c131a21282f363d444b525960676e757c838a91989fa6adb4bbc2c9d0d7dee5ecf3",
      },
    ),
  ) >= 0
}

// ---------------------------------------------------------------------------
// §5.6 ordering assertions — the negatives that bite
// ---------------------------------------------------------------------------

/// §5.6 asset-name order is length-first, then byte-lexicographic, so `42`
/// (1 B) precedes `4141` (2 B) and this run descends. The producer must
/// refuse it: the decoder does, so bytes that got past here would never
/// decode on either side.
test golden_f5_asset_names_reject_descending_order() fail {
  bytearray.length(
    encode_mint_policy_item(
      builtin.b_data(
        #"9ea5acb3bac1c8cfd6dde4ebf2f900070e151c232a31383f464d545b",
      ),
      builtin.map_data(
        [
          Pair(builtin.b_data(#"4141"), builtin.i_data(1)),
          Pair(builtin.b_data(#"42"), builtin.i_data(2)),
        ],
      ),
    ),
  ) >= 0
}

/// The duplicate half of the same rule, one level down.
test golden_f5_asset_names_reject_a_repeat() fail {
  bytearray.length(
    encode_mint_policy_item(
      builtin.b_data(
        #"9ea5acb3bac1c8cfd6dde4ebf2f900070e151c232a31383f464d545b",
      ),
      builtin.map_data(
        [
          Pair(builtin.b_data(#"41"), builtin.i_data(1)),
          Pair(builtin.b_data(#"41"), builtin.i_data(2)),
        ],
      ),
    ),
  ) >= 0
}

/// The field-level half: policy items carry the same comparator, and no
/// single item can see the order it sits in — only the run can.
test golden_f5_policy_ids_reject_descending_order() fail {
  bytearray.length(
    encode_mint_preimage(
      builtin.map_data(
        [
          Pair(
            builtin.b_data(
              #"bdc4cbd2d9e0e7eef5fc030a11181f262d343b424950575e656c737a",
            ),
            builtin.map_data([Pair(builtin.b_data(#"41"), builtin.i_data(1))]),
          ),
          Pair(
            builtin.b_data(
              #"9ea5acb3bac1c8cfd6dde4ebf2f900070e151c232a31383f464d545b",
            ),
            builtin.map_data([Pair(builtin.b_data(#"41"), builtin.i_data(2))]),
          ),
        ],
      ),
    ),
  ) >= 0
}

/// And the duplicate half of the field-level rule.
test golden_f5_policy_ids_reject_a_repeat() fail {
  bytearray.length(
    encode_mint_preimage(
      builtin.map_data(
        [
          Pair(
            builtin.b_data(
              #"9ea5acb3bac1c8cfd6dde4ebf2f900070e151c232a31383f464d545b",
            ),
            builtin.map_data([Pair(builtin.b_data(#"41"), builtin.i_data(1))]),
          ),
          Pair(
            builtin.b_data(
              #"9ea5acb3bac1c8cfd6dde4ebf2f900070e151c232a31383f464d545b",
            ),
            builtin.map_data([Pair(builtin.b_data(#"41"), builtin.i_data(2))]),
          ),
        ],
      ),
    ),
  ) >= 0
}

// ---------------------------------------------------------------------------
// §5.3 the two value sets and the fixed output index
// ---------------------------------------------------------------------------

/// §5.3 fields 0/1: the output index is always the fixed 3-byte `19 XXXX` form,
/// even for 0 and 23 which minimal CBOR spells in one byte. This is the sole
/// deliberately non-minimal encoding in the format.
test golden_fixed_output_index_matches_typescript() {
  and {
    encode_fixed_output_index(0) == #"190000",
    encode_fixed_output_index(23) == #"190017",
    encode_fixed_output_index(24) == #"190018",
    encode_fixed_output_index(255) == #"1900ff",
    encode_fixed_output_index(256) == #"190100",
    encode_fixed_output_index(65535) == #"19ffff",
  }
}

/// §5.3 fields 0/1: an out-ref's item encoding *is* its ledger MPF trie key and
/// its ledger database `outref` column. `ledger_outref_key` is pinned here
/// against bytes produced by the TypeScript trie-key producers, so the two
/// languages cannot key the ledger differently. The index set spans both sides
/// of the minimal-CBOR boundary at 23/24 — the only place where a minimal-index
/// encoder and this one differ in width, and therefore the only place a
/// regression would hide.
test golden_ledger_outref_key_matches_typescript() {
  and {
    ledger_outref_key(
      OutputReference {
        transaction_id: #"121920272e353c434a51585f666d747b828990979ea5acb3bac1c8cfd6dde4eb",
        output_index: 0,
      },
    ) == #"825820121920272e353c434a51585f666d747b828990979ea5acb3bac1c8cfd6dde4eb190000",
    ledger_outref_key(
      OutputReference {
        transaction_id: #"dbe2e9f0f7fe050c131a21282f363d444b525960676e757c838a91989fa6adb4",
        output_index: 23,
      },
    ) == #"825820dbe2e9f0f7fe050c131a21282f363d444b525960676e757c838a91989fa6adb4190017",
    ledger_outref_key(
      OutputReference {
        transaction_id: #"fa01080f161d242b323940474e555c636a71787f868d949ba2a9b0b7bec5ccd3",
        output_index: 24,
      },
    ) == #"825820fa01080f161d242b323940474e555c636a71787f868d949ba2a9b0b7bec5ccd3190018",
    ledger_outref_key(
      OutputReference {
        transaction_id: #"f3fa01080f161d242b323940474e555c636a71787f868d949ba2a9b0b7bec5cc",
        output_index: 255,
      },
    ) == #"825820f3fa01080f161d242b323940474e555c636a71787f868d949ba2a9b0b7bec5cc1900ff",
    ledger_outref_key(
      OutputReference {
        transaction_id: #"121920272e353c434a51585f666d747b828990979ea5acb3bac1c8cfd6dde4eb",
        output_index: 256,
      },
    ) == #"825820121920272e353c434a51585f666d747b828990979ea5acb3bac1c8cfd6dde4eb190100",
    ledger_outref_key(
      OutputReference {
        transaction_id: #"f3fa01080f161d242b323940474e555c636a71787f868d949ba2a9b0b7bec5cc",
        output_index: 65535,
      },
    ) == #"825820f3fa01080f161d242b323940474e555c636a71787f868d949ba2a9b0b7bec5cc19ffff",
  }
}

/// §5.3 field 6: exactly three admissible language tags. `MidgardV1` is 128 and
/// is the only one that is not a single byte — its canonical form is `18 80`.
/// The tag bytes are sliced out of the *encoder's own output*, not out of a
/// literal: slicing a literal and comparing it to a literal would assert
/// nothing about either language's encoder.
test golden_script_language_tags_match_typescript() {
  and {
    bytearray.take(
      bytearray.drop(
        encode_midgard_versioned_script(
          MidgardVersionedScript {
            language: NativeCardanoScript,
            script_bytes: #"8200581ce9f0f7fe050c131a21282f363d444b525960676e757c838a91989fa6",
          },
        ),
        1,
      ),
      1,
    ) == #"00",
    bytearray.take(
      bytearray.drop(
        encode_midgard_versioned_script(
          MidgardVersionedScript {
            language: PlutusV3Script,
            script_bytes: #"080f161d242b3239",
          },
        ),
        1,
      ),
      1,
    ) == #"03",
    bytearray.take(
      bytearray.drop(
        encode_midgard_versioned_script(
          MidgardVersionedScript {
            language: MidgardV1Script,
            script_bytes: #"272e353c434a5158",
          },
        ),
        1,
      ),
      2,
    ) == #"1880",
  }
}

/// §5.3 field 8: exactly seven admissible purpose tags, every one ≤ 23 and so
/// exactly one byte equal to its value. Values 0–5 reuse Cardano's own
/// `RedeemerTag` numbering; 6 (`Receive`) is Midgard-only.
test golden_redeemer_purpose_tags_match_typescript() {
  and {
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: SpendRedeemer,
        index: 1,
        redeemer_cbor: #"d87980",
        execution_units: MidgardExecutionUnits { memory: 2, steps: 3 },
      },
    ) == #"84000143d87980820203",
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: MintRedeemer,
        index: 1,
        redeemer_cbor: #"d87980",
        execution_units: MidgardExecutionUnits { memory: 2, steps: 3 },
      },
    ) == #"84010143d87980820203",
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: CertRedeemer,
        index: 1,
        redeemer_cbor: #"d87980",
        execution_units: MidgardExecutionUnits { memory: 2, steps: 3 },
      },
    ) == #"84020143d87980820203",
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: RewardRedeemer,
        index: 1,
        redeemer_cbor: #"d87980",
        execution_units: MidgardExecutionUnits { memory: 2, steps: 3 },
      },
    ) == #"84030143d87980820203",
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: VoteRedeemer,
        index: 1,
        redeemer_cbor: #"d87980",
        execution_units: MidgardExecutionUnits { memory: 2, steps: 3 },
      },
    ) == #"84040143d87980820203",
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: ProposeRedeemer,
        index: 1,
        redeemer_cbor: #"d87980",
        execution_units: MidgardExecutionUnits { memory: 2, steps: 3 },
      },
    ) == #"84050143d87980820203",
    encode_midgard_redeemer_witness(
      MidgardRedeemerWitness {
        purpose: ReceiveRedeemer,
        index: 1,
        redeemer_cbor: #"d87980",
        execution_units: MidgardExecutionUnits { memory: 2, steps: 3 },
      },
    ) == #"84060143d87980820203",
  }
}

// ---------------------------------------------------------------------------
// §2.4 field-preimage lengths — the wire-order transposition
// ---------------------------------------------------------------------------

/// §2.4 places `script_witnesses` at wire position 6 and `address_witnesses` at
/// 7 — transposed relative to the record declaration, which lists address before
/// script. Both twins already agree on this and MUST NOT change it. The nine
/// lengths below are pairwise distinct precisely so a transposition cannot hide:
/// the address length is 88 and the script length is 77, and the
/// encoded bytes put the script one first.
test golden_field_preimage_lengths_match_typescript() {
  encode_native_tx_field_preimage_lengths_v1(
    NativeTxFieldPreimageLengthsV1 {
      spend_inputs: 11,
      reference_inputs: 22,
      outputs: 33,
      required_observers: 44,
      required_signers: 55,
      mint: 66,
      address_witnesses: 88,
      script_witnesses: 77,
      redeemers: 99,
    },
  ) == #"890b161821182c18371842184d18581863"
}

// ---------------------------------------------------------------------------
// §8.4 tier-3 straddle at field 1's stride-40
// ---------------------------------------------------------------------------

const golden_straddle_block =
  #""

const golden_straddle_header = #"990190"

const golden_straddle_commitment =
  #"c33cac158cd252aeb86e3fafb6776fd03e7afacffa7923c05878afca870b4ef1"

fn golden_repeat_block(
  block: ByteArray,
  times: Int,
  acc: ByteArray,
) -> ByteArray {
  if times <= 0 {
    acc
  } else {
    golden_repeat_block(block, times - 1, bytearray.concat(acc, block))
  }
}

/// The straddle preimage, rebuilt here rather than read out of the vector: a
/// 10-element block of 400 bytes repeated 40 times behind the §5.1
/// header, giving 400 items and 16003 bytes. Both languages expand it and
/// hash the chunks for themselves, so the digests below are recomputed on each
/// side rather than pinned on one and counted on the other.
///
/// The carriage is field 1 (reference inputs), not field 0. The two share an
/// item encoder and stride 40, so these are field 0's bytes as well — but §5.4
/// caps field 0 at 296 spend inputs, a maximal preimage of 11843 bytes,
/// which still selects tier 1. Only field 1 can legally carry this many.
fn golden_straddle_preimage() -> ByteArray {
  bytearray.concat(
    golden_straddle_header,
    golden_repeat_block(golden_straddle_block, 40, #""),
  )
}

fn golden_straddle_chunks(preimage: ByteArray) -> List<ByteArray> {
  let count = 2
  list.map(
    list.range(0, count - 1),
    fn(index) {
      preimage
        |> bytearray.drop(index * chunk_bytes_k)
        |> bytearray.take(chunk_bytes_k)
    },
  )
}

/// Item 378 crosses the K boundary: its payload spans
/// [15125, 15163) while chunk 0 ends at 15148, so reading it stitches
/// bytes out of both chunks. Its neighbours are read too — they carry different
/// bytes, so an off-by-one that silently returned an adjacent item would fail.
test golden_straddle_read_matches_typescript() {
  let preimage = golden_straddle_preimage()
  let chunks = golden_straddle_chunks(preimage)
  let view = Chunked {
    chunks,
    chunk_digests: list.map(chunks, blake2b_256),
    count: 400,
    stride: 40,
  }
  and {
    bytearray.length(preimage) == 16003,
    field_commitment(preimage) == golden_straddle_commitment,
    list.map(chunks, bytearray.length) == [15148, 855],
    list.map(chunks, blake2b_256) == [
      #"aca116dea52dcd7df1d81db0f89b6538c62f12a9a058bb2a9746aafe80ca4282",
      #"2a5f24003a2f2ea29bd7bb3e2a8d305772011e94ccc2f862c2f19d2cb93fd8a4",
    ],
    field_item_extent(view, 377) == Pair(15085, 38),
    field_item_at(view, 377) == #"825820f8ff060d141b222930373e454c535a61686f767d848b9299a0a7aeb5bcc3cad1190007",
    field_item_extent(view, 378) == Pair(15125, 38),
    field_item_at(view, 378) == #"825820171e252c333a41484f565d646b727980878e959ca3aab1b8bfc6cdd4dbe2e9f0190008",
    field_item_extent(view, 379) == Pair(15165, 38),
    field_item_at(view, 379) == #"825820363d444b525960676e757c838a91989fa6adb4bbc2c9d0d7dee5ecf3fa01080f190009",
  }
}
