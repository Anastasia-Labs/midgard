/// Field 0 (spend_inputs), `empty`: 0 item(s),
/// 1 preimage bytes, §8 tier `Inline`.
test golden_f0_empty_matches_typescript() {
  and {
    encode_field_preimage(golden_f0_empty_items) == golden_f0_empty_preimage,
    field_commitment(golden_f0_empty_preimage) == golden_f0_empty_commitment,
    field_commitment_from_items(golden_f0_empty_items) == golden_f0_empty_commitment,
    decode_field_array_header(golden_f0_empty_preimage) == Pair(1, 0),
    field_stride(0) == 40,
  }
}

/// Field 0 (spend_inputs), `single`: 1 item(s),
/// 41 preimage bytes, §8 tier `Inline`.
test golden_f0_single_matches_typescript() {
  and {
