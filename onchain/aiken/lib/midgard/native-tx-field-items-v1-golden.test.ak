/// Field 8 (redeemers), `empty`: 0 item(s),
/// 1 preimage bytes, §8 tier `Inline`.
test golden_f8_empty_matches_typescript() {
  and {
    encode_field_preimage(golden_f8_empty_items) == golden_f8_empty_preimage,
    field_commitment(golden_f8_empty_preimage) == golden_f8_empty_commitment,
    field_commitment_from_items(golden_f8_empty_items) == golden_f8_empty_commitment,
    decode_field_array_header(golden_f8_empty_preimage) == Pair(1, 0),
    field_stride(8) == 0,
  }
}

