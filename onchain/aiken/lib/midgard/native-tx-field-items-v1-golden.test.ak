    field_commitment(golden_f0_single_preimage) == golden_f0_single_commitment,
    field_commitment_from_items(golden_f0_single_items) == golden_f0_single_commitment,
    decode_field_array_header(golden_f0_single_preimage) == Pair(1, 1),
    field_stride(0) == 40,
