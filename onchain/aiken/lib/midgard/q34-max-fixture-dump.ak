use aiken/cbor
use aiken/crypto.{blake2b_224}
use aiken/primitive/bytearray
use midgard/fraud_proofs/field_opening_v1.{
  WitnessAnchor, address_witnesses_field_index, opened_field_walk,
}
use midgard/fraud_proofs/native_binding_fixture_v1 as fixture
use midgard/fraud_proofs/native_tx/components.{
  decode_midgard_address_witness_cbor, encode_midgard_address_witness,
}
use midgard/fraud_proofs/native_tx/types.{MidgardAddressWitness}
use midgard/native_tx_field_access_v1.{encode_field_preimage}
use midgard/native_tx_machine_walk_v1.{
  encode_field_walk_checkpoint, field_walk_checkpoint_hash, walk_fold,
}
use midgard/script_proof_v1
use midgard/validation_merkle_v1

pub const maximum_witness_count: Int = 318

const sorted_verification_keys: ByteArray =
  #""

const signature: ByteArray =
  #"1111111111111111111111111111111111111111111111111111111111111111"
    |> bytearray.concat(
        #"1111111111111111111111111111111111111111111111111111111111111111",
      )

fn witness_items(
  remaining: Int,
  accumulated: List<ByteArray>,
) -> List<ByteArray> {
  if remaining == 0 {
    accumulated
  } else {
    let index = remaining - 1
    witness_items(
      index,
      [
        encode_midgard_address_witness(
          MidgardAddressWitness {
            verification_key: bytearray.slice(
              sorted_verification_keys,
              index * 32,
              index * 32 + 31,
            ),
            signature,
          },
        ),
        ..accumulated
      ],
    )
  }
}

pub fn literal_preimage_v1() -> ByteArray {
  encode_field_preimage(witness_items(maximum_witness_count, []))
}

type AccumulatorV1 {
  previous_signer_hash: ByteArray,
  signer_count: Int,
  signer_peaks: List<validation_merkle_v1.FrontierPeak>,
}

fn subject() {
  fixture.committed_field_preimage_block_fixture_v1(
    fixture.native_block_fixture_v1(fixture.valid_native_tx_v1()),
    address_witnesses_field_index,
    literal_preimage_v1(),
  )
}

fn opening() {
  let block = subject()
  fixture.certified_witness_opening(
    block.compact_cbor,
    block.witness_set_compact,
    literal_preimage_v1(),
  )
}

fn references() {
  let block = subject()
  fixture.certified_reference_inputs_v1(
    block.tx_id,
    address_witnesses_field_index,
    literal_preimage_v1(),
  )
}

fn append_signer(accumulator: AccumulatorV1, item: ByteArray) -> AccumulatorV1 {
  let witness = decode_midgard_address_witness_cbor(item)
  let signer_hash = blake2b_224(witness.verification_key)
  expect or {
      accumulator.previous_signer_hash == #"",
      bytearray.compare(accumulator.previous_signer_hash, signer_hash) != Greater,
    }
  AccumulatorV1 {
    previous_signer_hash: signer_hash,
    signer_count: accumulator.signer_count + 1,
    signer_peaks: validation_merkle_v1.append_leaf(
      accumulator.signer_count,
      accumulator.signer_peaks,
      script_proof_v1.signer_leaf_hash(signer_hash),
    ),
  }
}

fn pack(value: ByteArray) -> ByteArray {
  bytearray.from_int_big_endian(bytearray.length(value), 3)
    |> bytearray.concat(value)
}

fn initial_walk() {
  let preimage = literal_preimage_v1()
  let block = fixture.committed_field_preimage_block_fixture_v1(
    fixture.native_block_fixture_v1(fixture.valid_native_tx_v1()),
    address_witnesses_field_index,
    preimage,
  )
  let Pair(view, start) = opened_field_walk(
    fixture.certified_witness_opening(
      block.compact_cbor,
      block.witness_set_compact,
      preimage,
    ),
    WitnessAnchor {
      tx_id: block.tx_id,
      witness_set_hash: block.compact.witness_set_hash,
    },
    address_witnesses_field_index,
    fixture.certified_reference_inputs_v1(
      block.tx_id,
      address_witnesses_field_index,
      preimage,
    ),
    fixture.test_certificate_policy_id,
  )
  let empty = AccumulatorV1 {
    previous_signer_hash: #"",
    signer_count: 0,
    signer_peaks: validation_merkle_v1.empty_frontier(),
  }
  walk_fold(
    view,
    start,
    32,
    empty,
    fn(acc, _index, item) { append_signer(acc, item) },
  )
}

pub fn at_32() -> ByteArray {
  let Pair(accumulator, checkpoint) = initial_walk()
  pack(encode_field_walk_checkpoint(checkpoint))
    |> bytearray.concat(pack(field_walk_checkpoint_hash(checkpoint)))
    |> bytearray.concat(pack(accumulator.previous_signer_hash))
    |> bytearray.concat(pack(cbor.serialise(accumulator.signer_count)))
    |> bytearray.concat(
        pack(validation_merkle_v1.encode_frontier(accumulator.signer_peaks)),
      )
}

pub fn all() -> ByteArray {
  let block = subject()
  let witness = block.witness_set_compact
  pack(block.tx_id)
    |> bytearray.concat(pack(block.compact_cbor))
    |> bytearray.concat(pack(witness.addr_tx_wits_hash))
    |> bytearray.concat(pack(witness.script_tx_wits_hash))
    |> bytearray.concat(pack(witness.redeemer_tx_wits_hash))
    |> bytearray.concat(pack(block.compact.witness_set_hash))
}
