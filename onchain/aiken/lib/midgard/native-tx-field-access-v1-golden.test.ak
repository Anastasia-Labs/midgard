    encode_field_preimage(golden_single_item_payload_23_items) == golden_single_item_payload_23_preimage,
    field_commitment(golden_single_item_payload_23_preimage) == golden_single_item_payload_23_commitment,
    field_commitment_from_items(golden_single_item_payload_23_items) == golden_single_item_payload_23_commitment,
    decode_field_array_header(golden_single_item_payload_23_preimage) == Pair(
      1,
      1,
    ),
    field_item_extent(golden_single_item_payload_23_view, 0) == Pair(2, 23),
    field_item_at(golden_single_item_payload_23_view, 0) == #"ccd3dae1e8eff6fd040b121920272e353c434a51585f66",
  }
}

