    step_verifies(
      golden_pv11_value_contains_s24_cbor,
      golden_pv11_value_contains_s24_pre,
      golden_pv11_value_contains_s24_post,
    ),
    step_verifies(
      golden_pv11_value_contains_s25_cbor,
      golden_pv11_value_contains_s25_pre,
      golden_pv11_value_contains_s25_post,
    ),
    step_verifies(
      golden_pv11_value_contains_s26_cbor,
      golden_pv11_value_contains_s26_pre,
      golden_pv11_value_contains_s26_post,
    ),
    step_verifies(
      golden_pv11_value_contains_s27_cbor,
      golden_pv11_value_contains_s27_pre,
      golden_pv11_value_contains_s27_post,
    ),
  }
}

