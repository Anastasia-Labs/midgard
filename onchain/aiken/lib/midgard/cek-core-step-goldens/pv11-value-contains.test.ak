test golden_pv11_value_contains_twists_are_rejected() {
  and {
    step_is_rejected(golden_pv11_value_contains_post_cpu_minus_one_cbor),
    step_is_rejected(golden_pv11_value_contains_post_mode_flipped_cbor),
  }
}
