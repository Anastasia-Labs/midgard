use aiken/crypto.{blake2b_256}
use aiken/primitive/bytearray
use midgard/fraud_proofs/native_tx/codec.{encode_definite_bytes}

/// Canonical Midgard V1 cost-model view shared by PlutusV3 and MidgardV1: the
/// 350-entry Plutus V3 cost model, as a definite CBOR array.
const canonical_cost_model_view =
  #""

pub const empty_script_integrity_hash = #"f6" |> blake2b_256

pub fn expected_script_integrity_hash(
  redeemer_witness_hash: ByteArray,
  language_bitmap: Int,
) -> ByteArray {
  expect bytearray.length(redeemer_witness_hash) == 32
  expect language_bitmap >= 0
  expect language_bitmap <= 3
  if language_bitmap == 0 {
    empty_script_integrity_hash
  } else {
    let language_views = if language_bitmap == 1 {
      #"a102" |> bytearray.concat(canonical_cost_model_view)
    } else if language_bitmap == 2 {
      #"a11880" |> bytearray.concat(canonical_cost_model_view)
    } else {
      #"a202"
        |> bytearray.concat(canonical_cost_model_view)
        |> bytearray.concat(#"1880")
        |> bytearray.concat(canonical_cost_model_view)
    }
    #"82"
      |> bytearray.concat(encode_definite_bytes(redeemer_witness_hash))
      |> bytearray.concat(language_views)
      |> blake2b_256
  }
}
