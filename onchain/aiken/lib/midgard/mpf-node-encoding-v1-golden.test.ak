test member_4() {
  let proof = [
    mpf.Branch {
      skip: 1,
      neighbors: #"7cde7d48ab14063795f8803422e820e1dc0bbfb44075fa649d9b25a80766564185c09af929492a871e4fae32d9d5c36e352471cd659bcdb61de08f1722acc3b10eb923b0cbd24df54401d998531feead35a47a99f4deed205de4af81120f9761e628883b3cc93c8654978ab95a185434ff7b2f22cf5b36e2b7e998db8459575c",
    },
  ]
  and {
    mpf.has(
      mpf.from_root(trie_root),
      #"6d70662d6e6f64652d656e636f64696e672d76312f34",
      #"76616c75652d34",
      proof,
    ),
    mpf_proof_v1.has(
      trie_root,
      #"6d70662d6e6f64652d656e636f64696e672d76312f34",
      #"76616c75652d34",
      proof,
    ),
    mpf_proof_v1.has_value_hash(
      trie_root,
      #"6d70662d6e6f64652d656e636f64696e672d76312f34",
      blake2b_256(#"76616c75652d34"),
      proof,
    ),
  }
}

