pub fn literal_addr_hash_v1() -> ByteArray {
  literal_addr_hash
}

pub fn literal_script_hash_v1() -> ByteArray {
  literal_script_hash
}

pub fn literal_redeemer_hash_v1() -> ByteArray {
  literal_redeemer_hash
}

pub fn literal_preimage_v1() -> ByteArray {
  literal_preimage
}

pub const literal_overall_witness_hash: ByteArray =
  #"a20387a895cd4f73a0e4cd6ffd7921a904c3e5febf0fcfb719052567bfa6f637"

