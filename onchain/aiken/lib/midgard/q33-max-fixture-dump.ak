pub const literal_semantic_32: ByteArray =
  #"865820d4eafc0f14a743a05c3e5cc1aa36f26b420ec12a8a3c4473c5a458cd04c11f23410643002842430000e043000020430005c29ea3afc940b0cb2e094f38294bc570bd4891079b2f4b3e32f73d98581b2a25fd"

pub const literal_grammar_64: ByteArray =
  #"875820d4eafc0f14a743a05c3e5cc1aa36f26b420ec12a8a3c4473c5a458cd04c11f2341065820b8f88c7d45edf4fa4fd0ce03cc7d7fbb749d23395066a431f42c32461219e59c43002842430000e04300004043000b824ebe2860ac750760a224f48b28ccfd543755c20298583daa5e20e89cea5663b9"

pub const literal_semantic_64: ByteArray =
  #"865820d4eafc0f14a743a05c3e5cc1aa36f26b420ec12a8a3c4473c5a458cd04c11f23410643002842430000e04300004043000b82408d8f6a6670a304a31e7a9424c7ec08010c483fec435231eb187f2f5831456e"

pub const literal_grammar_192: ByteArray =
  #"875820d4eafc0f14a743a05c3e5cc1aa36f26b420ec12a8a3c4473c5a458cd04c11f2341065820b8f88c7d45edf4fa4fd0ce03cc7d7fbb749d23395066a431f42c32461219e59c43002842430000e0430000c043002282f42d64cfa9b51e341c5542019ecefd217880fc1cd342c7dd520aad8918c7f971"

pub const literal_semantic_192: ByteArray =
  #"865820d4eafc0f14a743a05c3e5cc1aa36f26b420ec12a8a3c4473c5a458cd04c11f23410643002842430000e0430000c043002282977213e7516788a1b8f3bd1a61005fd5b3c8601eeee3f81be70374442b1ad730"

pub const literal_grammar_224: ByteArray =
  #"875820d4eafc0f14a743a05c3e5cc1aa36f26b420ec12a8a3c4473c5a458cd04c11f2341065820b8f88c7d45edf4fa4fd0ce03cc7d7fbb749d23395066a431f42c32461219e59c43002842430000e0430000e043002842675bd6be18450912d589f2641626964a6a3f4c92bb71fedcf9ac76c9d8188a1d"

pub const literal_semantic_224: ByteArray =
  #"865820d4eafc0f14a743a05c3e5cc1aa36f26b420ec12a8a3c4473c5a458cd04c11f23410643002842430000e0430000e0430028423b9fc7d4459872a5abdce9ed0e66c203dcabf07e7ad6a30099b58e80844c232b"

fn scripts(
  remaining: Int,
  accumulated: List<MidgardVersionedScript>,
) -> List<MidgardVersionedScript> {
  if remaining <= 0 {
    accumulated
  } else {
    scripts(
      remaining - 1,
      [
        MidgardVersionedScript {
          language: NativeCardanoScript,
          script_bytes: #"8201828200581c"
            |> bytearray.concat(fixture.fraud_prover_key_hash)
            |> bytearray.concat(#"820519")
            |> bytearray.concat(
                bytearray.from_int_big_endian(20000 + remaining, 2),
              ),
        },
        ..accumulated
      ],
    )
  }
}

fn subject() -> fixture.NativeBlockFixtureV1 {
  let base = fixture.valid_native_tx_v1()
  fixture.native_block_fixture_v1(
    MidgardTransaction {
      ..base,
      witness_set: MidgardTransactionWitnessSet {
        ..base.witness_set,
        script_tx_wits: scripts(count, []),
      },
    },
  )
}

pub fn tx_id() -> ByteArray {
  subject().tx_id
}

pub fn compact_cbor() -> ByteArray {
  subject().compact_cbor
}

pub fn witness_hashes() -> ByteArray {
  let witness = subject().witness_set_compact
  witness.addr_tx_wits_hash
    |> bytearray.concat(witness.script_tx_wits_hash)
    |> bytearray.concat(witness.redeemer_tx_wits_hash)
}

pub fn overall_witness_hash() -> ByteArray {
  subject().compact.witness_set_hash
}

pub fn preimage() -> ByteArray {
  scripts(count, [])
    |> list.map(encode_midgard_versioned_script)
    |> encode_field_preimage
}

fn opening() {
  let block = subject()
  fixture.inline_witness_opening(
    block.compact_cbor,
    block.witness_set_compact,
    scripts(count, []) |> list.map(encode_midgard_versioned_script),
  )
}

fn grammar_after(budget: Int) {
  let block = subject()
  let Pair(view, start) = opened_field_grammar_certification(
    opening(),
    WitnessAnchor {
      tx_id: block.tx_id,
      witness_set_hash: block.compact.witness_set_hash,
    },
    script_witnesses_field_index,
    [],
    fixture.test_certificate_policy_id,
  )
  certify_field_grammar(view, start, budget)
}

fn semantic_after(budget: Int) {
  let block = subject()
  let terminal_grammar = grammar_after(count)
  let Pair(view, start) = opened_certified_field_walk_from_grammar(
    opening(),
    WitnessAnchor {
      tx_id: block.tx_id,
      witness_set_hash: block.compact.witness_set_hash,
    },
    script_witnesses_field_index,
    field_grammar_checkpoint_hash(terminal_grammar),
    encode_field_grammar_checkpoint(terminal_grammar),
    [],
    fixture.test_certificate_policy_id,
  )
  let Pair(_, checkpoint) = walk_fold(
    view,
    start,
    budget,
    False,
    fn(found, _index, _item) { found },
  )
  checkpoint
}

pub fn grammar_32() -> ByteArray {
  let checkpoint = grammar_after(32)
  encode_field_grammar_checkpoint(checkpoint)
    |> bytearray.concat(field_grammar_checkpoint_hash(checkpoint))
}

pub fn grammar_64() -> ByteArray {
  let checkpoint = grammar_after(64)
  encode_field_grammar_checkpoint(checkpoint)
    |> bytearray.concat(field_grammar_checkpoint_hash(checkpoint))
}

pub fn grammar_224() -> ByteArray {
  let checkpoint = grammar_after(224)
  encode_field_grammar_checkpoint(checkpoint)
    |> bytearray.concat(field_grammar_checkpoint_hash(checkpoint))
}

pub fn semantic_32() -> ByteArray {
  let checkpoint = semantic_after(32)
  encode_field_walk_checkpoint(checkpoint)
    |> bytearray.concat(field_walk_checkpoint_hash(checkpoint))
}

pub fn semantic_64() -> ByteArray {
  let checkpoint = semantic_after(64)
  encode_field_walk_checkpoint(checkpoint)
    |> bytearray.concat(field_walk_checkpoint_hash(checkpoint))
}

pub fn semantic_192() -> ByteArray {
  let checkpoint = semantic_after(192)
  encode_field_walk_checkpoint(checkpoint)
    |> bytearray.concat(field_walk_checkpoint_hash(checkpoint))
}

fn pack(value: ByteArray) -> ByteArray {
  bytearray.from_int_big_endian(bytearray.length(value), 3)
    |> bytearray.concat(value)
}

pub fn all() -> ByteArray {
  let block = subject()
  let field_preimage = preimage()
  let Pair(grammar_view, grammar_start) = opened_field_grammar_certification(
    opening(),
    WitnessAnchor {
      tx_id: block.tx_id,
      witness_set_hash: block.compact.witness_set_hash,
    },
    script_witnesses_field_index,
    [],
    fixture.test_certificate_policy_id,
  )
  let grammar_32_value = certify_field_grammar(grammar_view, grammar_start, 32)
  let grammar_64_value = certify_field_grammar(
    grammar_view,
    grammar_32_value,
    32,
  )
  let grammar_224_value = certify_field_grammar(
    grammar_view,
    grammar_64_value,
    160,
  )
  let Pair(semantic_view, semantic_start) = opened_certified_field_walk_from_grammar(
    opening(),
    WitnessAnchor {
      tx_id: block.tx_id,
      witness_set_hash: block.compact.witness_set_hash,
    },
    script_witnesses_field_index,
    field_grammar_checkpoint_hash(grammar_224_value),
    encode_field_grammar_checkpoint(grammar_224_value),
    [],
    fixture.test_certificate_policy_id,
  )
  let Pair(_, semantic_32_value) = walk_fold(
    semantic_view,
    semantic_start,
    32,
    False,
    fn(found, _index, _item) { found },
  )
  let Pair(_, semantic_64_value) = walk_fold(
    semantic_view,
    semantic_32_value,
    32,
    False,
    fn(found, _index, _item) { found },
  )
  let Pair(_, semantic_192_value) = walk_fold(
    semantic_view,
    semantic_64_value,
    128,
    False,
    fn(found, _index, _item) { found },
  )
  let witness = block.witness_set_compact
  let packed_grammar_32 = encode_field_grammar_checkpoint(grammar_32_value)
    |> bytearray.concat(field_grammar_checkpoint_hash(grammar_32_value))
  let packed_grammar_64 = encode_field_grammar_checkpoint(grammar_64_value)
    |> bytearray.concat(field_grammar_checkpoint_hash(grammar_64_value))
  let packed_grammar_224 = encode_field_grammar_checkpoint(grammar_224_value)
    |> bytearray.concat(field_grammar_checkpoint_hash(grammar_224_value))
  let packed_semantic_32 = encode_field_walk_checkpoint(semantic_32_value)
    |> bytearray.concat(field_walk_checkpoint_hash(semantic_32_value))
  let packed_semantic_64 = encode_field_walk_checkpoint(semantic_64_value)
    |> bytearray.concat(field_walk_checkpoint_hash(semantic_64_value))
  let packed_semantic_192 = encode_field_walk_checkpoint(semantic_192_value)
    |> bytearray.concat(field_walk_checkpoint_hash(semantic_192_value))
  pack(block.tx_id)
    |> bytearray.concat(pack(block.compact_cbor))
    |> bytearray.concat(pack(witness.addr_tx_wits_hash))
    |> bytearray.concat(pack(witness.script_tx_wits_hash))
    |> bytearray.concat(pack(witness.redeemer_tx_wits_hash))
    |> bytearray.concat(pack(field_preimage))
    |> bytearray.concat(pack(packed_grammar_32))
    |> bytearray.concat(pack(packed_grammar_64))
    |> bytearray.concat(pack(packed_grammar_224))
    |> bytearray.concat(pack(packed_semantic_32))
    |> bytearray.concat(pack(packed_semantic_64))
    |> bytearray.concat(pack(packed_semantic_192))
}
