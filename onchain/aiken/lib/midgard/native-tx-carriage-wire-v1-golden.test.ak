/// FieldPreimageCertificateMintRedeemerV1 /
/// `mint_redeemer_trailing_bytes`: a valid `Retire` encoding followed by
/// a complete extra CBOR item. Refused before any typing happens —
/// `cbor.deserialise` answers `None` unless the payload is exactly one
/// CBOR item.
test golden_mint_redeemer_trailing_bytes_rejects() {
  cbor.deserialise(mint_redeemer_trailing_bytes_cbor) == None
}

const mint_redeemer_constructor_index_out_of_range_cbor: ByteArray = #"d87b80"

/// `mint_redeemer_constructor_index_out_of_range` is well-formed CBOR.
/// This is what keeps the `fail` test below honest: its refusal has to
/// come from the cast into FieldPreimageCertificateMintRedeemerV1, not
/// from the parse.
test golden_mint_redeemer_constructor_index_out_of_range_parses_as_cbor() {
  cbor.deserialise(mint_redeemer_constructor_index_out_of_range_cbor) != None
}

/// FieldPreimageCertificateMintRedeemerV1 /
/// `mint_redeemer_constructor_index_out_of_range`: constructor index 2;
/// the mint redeemer declares exactly Certify/Retire at 0/1, and a third
/// arm is how a burn-only policy would be talked into minting.
test golden_mint_redeemer_constructor_index_out_of_range_rejects() fail {
  expect Some(decoded_data) = cbor.deserialise(
    mint_redeemer_constructor_index_out_of_range_cbor,
  )
  expect _decoded: FieldPreimageCertificateMintRedeemerV1 = decoded_data
  True
}

