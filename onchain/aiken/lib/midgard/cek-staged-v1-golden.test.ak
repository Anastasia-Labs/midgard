}

// ## Integers

test integer_zero() {
  let encoded = cbor.serialise(0)
  let parsed = parse_canonical_integer_cbor_v1(encoded)
  let root = #"5fb8c7d0d530210e8dc0ab900c98c42577fe756e39777c1e516c187f89e55df3"
  and {
    flat_root_v1(encoded) == root,
    builtin.length_of_bytearray(encoded) == 1,
    magnitude_words_v1(parsed) == 1,
    integer_leaf_from_cbor_v1(root, 1, 1).root == #"0c4e8e7a8396d11dd8c0554ec32416c3257d87175f2dfcc7714469663e0f1da2",
    encode_canonical_integer_cbor_v1(parsed) == encoded,
  }
}

