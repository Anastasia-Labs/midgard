// ## Staged operands

test staged_operand_of_0_bytes() {
  let runs = runs_of(pattern_chunks(0, 3))
  let Pair(inputs, refs) = staged(runs)
  let bound = bind_operand_v1(
    collect_runs_v1(inputs, refs),
    list.range(0, list.length(runs) - 1),
  )
  and {
    bound.root == #"5b5fb0c983697cff1977899896435e4e8f24cd6f761099da0c4a04a6a90e1c6c",
    bound.length == 0,
  }
}

test staged_operand_of_9216_bytes() {
  let runs = runs_of(pattern_chunks(9216, 183))
  let Pair(inputs, refs) = staged(runs)
  let bound = bind_operand_v1(
    collect_runs_v1(inputs, refs),
    list.range(0, list.length(runs) - 1),
  )
  and {
    bound.root == #"26ff45cf8a8f65c95dbe4135c2957a616b89300452182c9e1d3564487501eb66",
    bound.length == 9216,
  }
}

test staged_operand_of_65536_bytes() {
  let runs = runs_of(pattern_chunks(65536, 28))
  let Pair(inputs, refs) = staged(runs)
  let bound = bind_operand_v1(
    collect_runs_v1(inputs, refs),
    list.range(0, list.length(runs) - 1),
  )
  and {
    bound.root == #"047f6fcfd2624c591c5e6701ba9aef8257e6ffbb5a49779e41b6109ee73ec1da",
    bound.length == 65536,
  }
}

test staged_operand_of_131072_bytes() {
  let runs = runs_of(pattern_chunks(131072, 53))
