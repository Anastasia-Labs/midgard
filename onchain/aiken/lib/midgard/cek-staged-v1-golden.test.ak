//// Generated by demo/midgard-core/scripts/generate-cek-staged-v1-goldens.mjs.
//// Do not edit; regenerate with
//// `pnpm --dir demo/midgard-core run fixtures:cek-staged-v1:sync`.
////
//// Roots, lengths, memory words and leaves computed by the TypeScript twins of
//// cek_staged_blob_v1 and cek_staged_integer_v1, required of the Aiken
//// libraries on the same inputs.

use aiken/builtin
use aiken/cbor
use aiken/collection/list
use cardano/address
use cardano/assets
use cardano/transaction.{InlineDatum, Input, NoDatum, Output, OutputReference}
use midgard/cek_proof_v1
use midgard/cek_staged_blob_v1.{
  bind_operand_v1, chunk_bytes, collect_runs_v1, flat_root_of_pieces_v1,
  flat_root_v1,
}
use midgard/cek_staged_integer_v1.{
  SignedLimbsV1, add_signed_v1, encode_canonical_integer_cbor_v1,
  integer_cbor_from_magnitude_v1, integer_leaf_from_cbor_v1, magnitude_words_v1,
  parse_canonical_integer_cbor_v1, signed_limbs_v1, subtract_signed_v1,
}

// ## Inputs

fn ascending(from: Int, acc: ByteArray) -> ByteArray {
  if from < 0 {
    acc
  } else {
    ascending(from - 1, builtin.cons_bytearray(from, acc))
  }
}

fn repeat_to(block: ByteArray, length: Int) -> ByteArray {
  if builtin.length_of_bytearray(block) >= length {
    builtin.slice_bytearray(0, length, block)
  } else {
    repeat_to(builtin.append_bytearray(block, block), length)
  }
}

/// `length` bytes (at most 65,536) where byte i is (i + shift) mod 256.
fn pattern(length: Int, shift: Int) -> ByteArray {
  let block = ascending(255, #"")
  repeat_to(
    builtin.slice_bytearray(shift, 256, builtin.append_bytearray(block, block)),
    length,
  )
}

/// `pattern(length, shift)` at any length, as pieces of at most 65,536 bytes.
fn pattern_pieces(length: Int, shift: Int) -> List<ByteArray> {
  if length <= 65536 {
    [pattern(length, shift)]
  } else {
    [pattern(65536, shift), ..pattern_pieces(length - 65536, shift)]
  }
}

/// The 4,095-byte chunks of `pattern(length, shift)` at any length.
fn pattern_chunks(length: Int, shift: Int) -> List<ByteArray> {
  if length <= chunk_bytes {
    [pattern(length, shift)]
  } else {
    [
      pattern(chunk_bytes, shift),
      ..pattern_chunks(length - chunk_bytes, ( shift + chunk_bytes ) % 256)
    ]
  }
}

fn runs_of(chunks: List<ByteArray>) -> List<List<ByteArray>> {
  when chunks is {
    [a, b, c, ..rest] -> [[a, b, c], ..runs_of(rest)]
    [] -> []
    short -> [short]
  }
}

fn reference(seed: Int) -> OutputReference {
  OutputReference {
    transaction_id: builtin.blake2b_256(builtin.cons_bytearray(seed, #"")),
    output_index: seed,
  }
}

fn output(datum) -> Output {
  Output {
    address: address.from_verification_key(builtin.replicate_byte(28, 7)),
    value: assets.from_lovelace(2000000),
    datum,
    reference_script: None,
  }
}

/// Staging reference inputs for `runs`, after one that is not a staging
/// output, and the references naming them.
fn staged(
  runs: List<List<ByteArray>>,
) -> Pair<List<Input>, List<OutputReference>> {
  let seeds = list.indexed_map(runs, fn(index, _) { 10 + index })
  let staging = list.map2(
    seeds,
    runs,
    fn(seed, chunks) {
      Input {
        output_reference: reference(seed),
        output: output(
          InlineDatum(
            builtin.constr_data(
              0,
              [
                builtin.list_data(
                  list.map(chunks, fn(chunk) { builtin.b_data(chunk) }),
                ),
              ],
            ),
          ),
        ),
      }
    },
  )
  Pair(
    [
      Input { output_reference: reference(1), output: output(NoDatum) },
      ..staging
    ],
    list.map(seeds, reference),
  )
}

fn replicate(size: Int, byte: Int) -> ByteArray {
  if size <= 8192 {
    builtin.replicate_byte(size, byte)
  } else {
    builtin.append_bytearray(
      builtin.replicate_byte(8192, byte),
      replicate(size - 8192, byte),
    )
  }
}

fn small_power(bits: Int) -> Int {
  if bits == 0 {
    1
  } else {
    2 * small_power(bits - 1)
  }
}

fn power(bits: Int) -> Int {
  builtin.bytearray_to_integer(
    True,
    builtin.cons_bytearray(small_power(bits % 8), replicate(bits / 8, 0)),
  )
}

fn repeated(size: Int, byte: Int) -> Int {
  builtin.bytearray_to_integer(True, replicate(size, byte))
}

fn counting_bytes(size: Int, acc: ByteArray) -> ByteArray {
  if size == 0 {
    acc
  } else {
    counting_bytes(size - 1, builtin.cons_bytearray(size % 255 + 1, acc))
  }
}

fn counting(size: Int) -> Int {
  builtin.bytearray_to_integer(True, counting_bytes(size, #""))
}

fn largest() -> Int {
  builtin.bytearray_to_integer(
    True,
    builtin.cons_bytearray(0x7f, replicate(32767, 0xff)),
  )
}

fn smallest() -> Int {
  -largest() - 1
}

fn limbs_of(n: Int) -> SignedLimbsV1 {
  signed_limbs_v1(parse_canonical_integer_cbor_v1(cbor.serialise(n)))
}

