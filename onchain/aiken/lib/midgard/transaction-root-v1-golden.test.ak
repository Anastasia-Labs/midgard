  expect Some(data) = cbor.deserialise(forced_beta_unbalanced_value_cbor)
  expect value: ledger_state.ForcedInclusionTxV1 = data
  expect Some(order_data) = cbor.deserialise(forced_beta_unbalanced_key)
  expect order: OutputReference = order_data
  and {
    cbor.serialise(value) == forced_beta_unbalanced_value_cbor,
    cbor.serialise(order) == forced_beta_unbalanced_key,
    order.transaction_id == forced_beta_unbalanced_order_transaction_id,
    order.output_index == 2,
    value.tx_id == #"68ed60a04daa6faded15da8cb0c1013565b75bdf54f9b4d707d64fdfeb37b63f",
    value.transaction_commitment == forced_beta_unbalanced_transaction_commitment,
    value.source.compact_cbor == forced_beta_unbalanced_compact_cbor,
    value.source.witness_set_compact_cbor == forced_beta_unbalanced_witness_set_compact_cbor,
    value.source.field_preimage_lengths_cbor == forced_beta_unbalanced_field_preimage_lengths_cbor,
    value.operator_validity == ledger_state.UnbalancedTx,
  }
}
