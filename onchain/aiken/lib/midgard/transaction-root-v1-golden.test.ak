fn transactions_keys_are_canonical() -> Bool {
  bytearray.compare(transaction_alpha_key, transaction_beta_key) == Less
}

fn forced_transaction_order_keys_are_canonical() -> Bool {
  and {
    bytearray.compare(forced_alpha_valid_key, forced_alpha_missing_input_key) == Less,
    bytearray.compare(
      forced_alpha_missing_input_key,
      forced_alpha_invalid_signature_key,
    ) == Less,
    bytearray.compare(
      forced_alpha_invalid_signature_key,
      forced_beta_failed_script_key,
    ) == Less,
    bytearray.compare(
      forced_beta_failed_script_key,
      forced_beta_fee_too_low_key,
    ) == Less,
    bytearray.compare(forced_beta_fee_too_low_key, forced_beta_unbalanced_key) == Less,
  }
}

test rf031_transaction_root_uses_exact_domain_and_ordering() {
  and {
    transactions_keys_are_canonical(),
    transaction_alpha_membership_is_exact(),
    transaction_beta_membership_is_exact(),
    transition_trace.commit_counted_root(
      transition_trace.TransactionsV1RootDomain,
      transactions_phas_root,
      2,
    ) == transactions_root,
  }
}

test rf031_forced_transaction_root_uses_order_keys_and_domain() {
  and {
    forced_transaction_order_keys_are_canonical(),
    forced_alpha_valid_membership_is_exact(),
    forced_alpha_missing_input_membership_is_exact(),
    forced_alpha_invalid_signature_membership_is_exact(),
    forced_beta_failed_script_membership_is_exact(),
    forced_beta_fee_too_low_membership_is_exact(),
    forced_beta_unbalanced_membership_is_exact(),
    transition_trace.commit_counted_root(
      transition_trace.ForcedTransactionsV1RootDomain,
      forced_transactions_phas_root,
      6,
    ) == forced_transactions_root,
    forced_transactions_root != transition_trace.commit_counted_root(
      transition_trace.TransactionsV1RootDomain,
      forced_transactions_phas_root,
      6,
    ),
  }
}

