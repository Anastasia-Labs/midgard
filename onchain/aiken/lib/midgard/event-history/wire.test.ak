//// Captured SDK withdrawal with a 4,000-byte inline destination datum.
//// Lucid maps are indefinite; SDK commitments normalize using the existing
//// map-order-preserving serialiseData encoder. Both encodings decode equally.

use aiken/cbor
use midgard/event_history/order_facts
use midgard/event_history/retained_data

const raw =
  #""

test storage_hash_matches_sdk() {
  expect Some(data) = cbor.deserialise(raw)
  expect stored: retained_data.EventData = data
  retained_data.datum_hash(stored) == #"cbedc8fca1a2059c8dfacd03609106e9a909bbf04e0fd0c4f336e12ca01a28da"
}

test payload_decodes() {
  expect Some(data) = cbor.deserialise(raw)
  expect stored: retained_data.EventData = data
  expect payload: order_facts.Payload = stored.event_payload
  order_facts.matches_kind(payload, order_facts.Withdrawal)
}

test serialization_matches_sdk() {
  expect Some(data) = cbor.deserialise(raw)
  expect stored: retained_data.EventData = data
  cbor.serialise(stored) == #""
}
