        terminal_accumulator: #"abababababababababababababababababababababababababababababababab",
      },
    ],
  }
}

/// The signed message, pinned so a changed `CommitmentV1` encoding fails
/// here by name rather than as 256 failing signatures.
test capacity_attestation_message_is_pinned() {
  availability.attestation_message_v1(capacity_availability_commitment()) == #"3133fbe53a513a7e9a4e53afa5272393de6b51016e0e729045d450250a1915ae"
}

