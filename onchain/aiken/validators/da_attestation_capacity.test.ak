use aiken/fuzz
use aiken/primitive/bytearray
use cardano/address
use cardano/assets.{AssetName, PolicyId, Value}
use cardano/transaction.{
  InlineDatum, Input, Output, OutputReference, Transaction,
}
use cardano/transaction as tx
use da_attestation.{validate_add_signatures}
use midgard/da_attestation_types.{
  DaAttestationDatum, attestation_asset_name_prefix,
  signature_witness_byte_count, verification_key_byte_count,
}
use midgard/ledger_state.{HeaderHash}

// Deterministic Ed25519 fixture for DA signature capacity regression.
// Seeds are sha256("midgard-da-capacity-regression-v1:" <> u32be(index)).
// Signer verification keys are packed in ascending byte order.
const capacity_fixture_signature_count: Int = 256

const regression_signature_count: Int = 132

type CapacityFixture {
  CapacityFixture {
    input_datum: DaAttestationDatum,
    signatures: ByteArray,
    tx: Transaction,
  }
}

const capacity_da_policy: PolicyId =
  #"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const capacity_ref: OutputReference =
  OutputReference {
    transaction_id: #"2222222222222222222222222222222222222222222222222222222222222222",
    output_index: 0,
  }

const capacity_header_hash: HeaderHash =
  #"11111111111111111111111111111111111111111111111111111111"

const capacity_remaining_signers_0: ByteArray =
  #""

const capacity_remaining_signers_1: ByteArray =
  #""

const capacity_remaining_signers_2: ByteArray =
  #""

const capacity_remaining_signers_3: ByteArray =
  #""

const capacity_remaining_signers_4: ByteArray =
  #""

const capacity_remaining_signers_5: ByteArray =
  #""

const capacity_remaining_signers_6: ByteArray =
  #""

const capacity_remaining_signers_7: ByteArray =
  #""

const capacity_remaining_signers_8: ByteArray =
  #""

const capacity_remaining_signers_9: ByteArray =
  #""

const capacity_remaining_signers_10: ByteArray =
  #""

const capacity_remaining_signers_11: ByteArray =
  #""

const capacity_remaining_signers_12: ByteArray =
  #""

const capacity_remaining_signers_13: ByteArray =
  #""

const capacity_remaining_signers_14: ByteArray =
  #""

const capacity_remaining_signers_15: ByteArray =
  #""

const capacity_remaining_signers: ByteArray =
  capacity_remaining_signers_0
    |> bytearray.concat(capacity_remaining_signers_1)
    |> bytearray.concat(capacity_remaining_signers_2)
    |> bytearray.concat(capacity_remaining_signers_3)
    |> bytearray.concat(capacity_remaining_signers_4)
    |> bytearray.concat(capacity_remaining_signers_5)
    |> bytearray.concat(capacity_remaining_signers_6)
    |> bytearray.concat(capacity_remaining_signers_7)
    |> bytearray.concat(capacity_remaining_signers_8)
    |> bytearray.concat(capacity_remaining_signers_9)
    |> bytearray.concat(capacity_remaining_signers_10)
    |> bytearray.concat(capacity_remaining_signers_11)
    |> bytearray.concat(capacity_remaining_signers_12)
    |> bytearray.concat(capacity_remaining_signers_13)
    |> bytearray.concat(capacity_remaining_signers_14)
    |> bytearray.concat(capacity_remaining_signers_15)

const capacity_signatures_0: ByteArray =
  #""

const capacity_signatures_1: ByteArray =
  #""

const capacity_signatures_2: ByteArray =
  #""

const capacity_signatures_3: ByteArray =
  #""

const capacity_signatures_4: ByteArray =
  #""

const capacity_signatures_5: ByteArray =
  #""

const capacity_signatures_6: ByteArray =
  #""

const capacity_signatures_7: ByteArray =
  #""

const capacity_signatures_8: ByteArray =
  #""

const capacity_signatures_9: ByteArray =
  #""

const capacity_signatures_10: ByteArray =
  #""

const capacity_signatures_11: ByteArray =
  #""

const capacity_signatures_12: ByteArray =
  #""

const capacity_signatures_13: ByteArray =
  #""

const capacity_signatures_14: ByteArray =
  #""

const capacity_signatures_15: ByteArray =
  #""

const capacity_signatures_16: ByteArray =
  #""

const capacity_signatures_17: ByteArray =
  #""

const capacity_signatures_18: ByteArray =
  #""

