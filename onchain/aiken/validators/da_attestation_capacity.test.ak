  #""

const capacity_signatures_28: ByteArray =
  #""

const capacity_signatures_29: ByteArray =
  #""

const capacity_signatures_30: ByteArray =
  #""

const capacity_signatures_31: ByteArray =
  #""

const capacity_signatures: ByteArray =
  capacity_signatures_0
    |> bytearray.concat(capacity_signatures_1)
    |> bytearray.concat(capacity_signatures_2)
    |> bytearray.concat(capacity_signatures_3)
    |> bytearray.concat(capacity_signatures_4)
    |> bytearray.concat(capacity_signatures_5)
    |> bytearray.concat(capacity_signatures_6)
    |> bytearray.concat(capacity_signatures_7)
    |> bytearray.concat(capacity_signatures_8)
    |> bytearray.concat(capacity_signatures_9)
    |> bytearray.concat(capacity_signatures_10)
    |> bytearray.concat(capacity_signatures_11)
    |> bytearray.concat(capacity_signatures_12)
    |> bytearray.concat(capacity_signatures_13)
    |> bytearray.concat(capacity_signatures_14)
    |> bytearray.concat(capacity_signatures_15)
    |> bytearray.concat(capacity_signatures_16)
    |> bytearray.concat(capacity_signatures_17)
    |> bytearray.concat(capacity_signatures_18)
    |> bytearray.concat(capacity_signatures_19)
    |> bytearray.concat(capacity_signatures_20)
    |> bytearray.concat(capacity_signatures_21)
    |> bytearray.concat(capacity_signatures_22)
    |> bytearray.concat(capacity_signatures_23)
    |> bytearray.concat(capacity_signatures_24)
    |> bytearray.concat(capacity_signatures_25)
    |> bytearray.concat(capacity_signatures_26)
    |> bytearray.concat(capacity_signatures_27)
    |> bytearray.concat(capacity_signatures_28)
    |> bytearray.concat(capacity_signatures_29)
    |> bytearray.concat(capacity_signatures_30)
    |> bytearray.concat(capacity_signatures_31)

fn slice_len(bytes: ByteArray, offset: Int, length: Int) -> ByteArray {
  expect length >= 0
  if length == 0 {
    #""
  } else {
    bytearray.slice(bytes, offset, offset + length - 1)
  }
}

fn capacity_attestation_asset() -> AssetName {
  attestation_asset_name_prefix |> bytearray.concat(capacity_header_hash)
}

fn capacity_value() -> Value {
  assets.from_lovelace(2_000_000)
    |> assets.add(capacity_da_policy, capacity_attestation_asset(), 1)
}

fn capacity_input_datum(signature_count: Int) -> DaAttestationDatum {
  expect signature_count > 0
  expect signature_count <= capacity_fixture_signature_count
  DaAttestationDatum {
    header_hash: capacity_header_hash,
    da_threshold: signature_count,
    remaining_signers: slice_len(
      capacity_remaining_signers,
      0,
      signature_count * verification_key_byte_count,
    ),
    attestation_count: 0,
  }
}

fn capacity_output_datum(signature_count: Int) -> DaAttestationDatum {
  DaAttestationDatum {
    header_hash: capacity_header_hash,
    da_threshold: signature_count,
    remaining_signers: #"",
    attestation_count: signature_count,
  }
}

fn capacity_input(signature_count: Int) -> Input {
  Input {
    output_reference: capacity_ref,
    output: Output {
      address: address.from_script(capacity_da_policy),
      value: capacity_value(),
      datum: InlineDatum(capacity_input_datum(signature_count)),
      reference_script: None,
    },
  }
}

fn capacity_output(signature_count: Int) -> Output {
  Output {
    address: address.from_script(capacity_da_policy),
    value: capacity_value(),
    datum: InlineDatum(capacity_output_datum(signature_count)),
    reference_script: None,
  }
}

fn capacity_tx(signature_count: Int) -> Transaction {
  Transaction {
    ..tx.placeholder,
    inputs: [capacity_input(signature_count)],
    outputs: [capacity_output(signature_count)],
  }
}

fn capacity_fixture(signature_count: Int) -> CapacityFixture {
  CapacityFixture {
    input_datum: capacity_input_datum(signature_count),
    signatures: slice_len(
      capacity_signatures,
      0,
      signature_count * signature_witness_byte_count,
    ),
    tx: capacity_tx(signature_count),
  }
}

fn sample_132_capacity_fixture(_size: Int) -> Fuzzer<CapacityFixture> {
  fuzz.constant(capacity_fixture(regression_signature_count))
}

fn sample_capacity_curve_fixture(size: Int) -> Fuzzer<CapacityFixture> {
  fuzz.constant(capacity_fixture(size + 1))
}

fn validate_capacity_add_signatures(fixture: CapacityFixture) -> Bool {
  let CapacityFixture { input_datum, signatures, tx } = fixture
  validate_add_signatures(Some(input_datum), 0, signatures, capacity_ref, tx)
}

test da_attestation_add_132_signatures_regression() {
  validate_capacity_add_signatures(capacity_fixture(regression_signature_count))
}

bench da_attestation_add_132_signatures_bench(
  fixture: CapacityFixture via sample_132_capacity_fixture,
) {
  validate_capacity_add_signatures(fixture)
}

bench da_attestation_add_signature_capacity_curve(
  fixture: CapacityFixture via sample_capacity_curve_fixture,
) {
  validate_capacity_add_signatures(fixture)
}
