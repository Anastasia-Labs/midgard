          memory: 4100,
        },
        memory: 4096,
      },
      ConstantValue(
        ConstantWitnessV1 { type_cbor: #"9f00ff", payload_cbor: #"01" },
      ),
    ],
    SemanticConstantValue {
      type_cbor: #"9f00ff",
      payload: DataSummaryV1 {
        root: #"8113ecacdcda96ee5b48363704904e3bd8c3c2406cabb3112654fec49c24ce28",
        cbor_length: 33795,
        memory: 4100,
      },
      memory: 4096,
    },
    material(
      staging,
      [
        staged(0),
        InlineOperand {
          bytes: encode_integer_cbor_bulk_v1(
            CanonicalIntegerV1 { negative: False, argument: #"01" },
          ),
        },
      ],
    ),
    staging.reference_inputs,
  )
}

test admits_a_difference_one_past_the_smallest_has_the_typescript_witness() {
  let step = admits_a_difference_one_past_the_smallest_step()
  expect Some(datum) = step.datum
  expect Some(bound) = datum.data
  bound.witness_hash == #"e13e14a216e931432eee6a3a6a84cb1b0b2b346c234dd0f313572dbbfca664ed"
}

test admits_a_difference_one_past_the_smallest() {
  spend_staged_integer(admits_a_difference_one_past_the_smallest_step())
}
