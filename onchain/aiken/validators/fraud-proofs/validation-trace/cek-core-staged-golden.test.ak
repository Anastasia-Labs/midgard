          CanonicalIntegerV1 {
            negative: False,
            argument: builtin.append_bytearray(#"3f", repeat_byte(32767, 255)),
          },
        ),
      ],
      [
        encode_integer_cbor_bulk_v1(
          CanonicalIntegerV1 {
            negative: False,
            argument: builtin.append_bytearray(#"3f", repeat_byte(32767, 255)),
          },
        ),
      ],
    ],
  )
  staged_step(
    0,
    [
      SemanticConstantValue {
