fn fail_past_64_bytes_case() -> WriteBitsCaseV1 {
  case_of(
    #"",
    #"64717e8b98a5b2bfccd9e6f3000d1a2734414e5b6875828f9ca9b6c3d0ddeaf704111e2b3845525f6c798693a0adbac7d4e1eefb0815222f3c495663707d8a97",
    [
      0, 37, 74, 111, 148, 185, 222, 259, 296, 333, 370, 407, 444, 481, 6, 43,
      80, 117, 154, 191, 228, 265, 302, 339, 376, 413, 450, 487, 12, 49, 86, 123,
      160, 197, 234, 271, 308, 345, 382, 419, 456, 493, 18, 55, 92, 129, 166,
      203, 240, 277, 314, 351, 388, 425, 462, 499, 24, 61, 98, 135, 172, 209,
      246, 283, 320, 357, 394, 431, 468, 505, 512, 67, 104, 141, 178, 215, 252,
      289, 326, 363, 400, 437, 474, 511, 36, 73, 110, 147, 184, 221, 258, 295,
      332, 369, 406, 443, 480, 5, 42, 79,
    ],
    0,
    0,
  )
}

test fail_past_64_bytes_witness_is_the_executors() {
  cbor.serialise(fail_past_64_bytes_case().witness) == #""
}

