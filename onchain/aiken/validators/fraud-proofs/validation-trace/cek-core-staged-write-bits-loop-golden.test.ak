fn clear_200_of_512_bytes_case() -> WriteBitsCaseV1 {
  case_of(
    #"",
    #"",
    [
      5, 42, 79, 116, 153, 190, 227, 264, 301, 338, 375, 412, 449, 486, 523, 560,
      597, 634, 671, 708, 745, 782, 819, 856, 893, 930, 967, 1004, 1041, 1078,
      1115, 1152, 1189, 1226, 1263, 1300, 1337, 1374, 1411, 1448, 1485, 1522,
      1559, 1596, 1633, 1670, 1707, 1744, 1781, 1818, 1855, 1892, 1929, 1966,
      2003, 2040, 2077, 2114, 2151, 2188, 2225, 2262, 2299, 2336, 2373, 2410,
      2447, 2484, 2521, 2558, 2595, 2632, 2669, 2706, 2743, 2780, 2817, 2854,
      2891, 2928, 2965, 3002, 3039, 3076, 3113, 3150, 3187, 3224, 3261, 3298,
      3335, 3372, 3409, 3446, 3483, 3520, 3557, 3594, 3631, 3668, 3705, 3742,
      3779, 3816, 3853, 3890, 3927, 3964, 4001, 4038, 4075, 16, 53, 90, 127, 164,
      201, 238, 275, 312, 349, 386, 423, 460, 497, 534, 571, 608, 645, 682, 719,
      756, 793, 830, 867, 904, 941, 978, 1015, 1052, 1089, 1126, 1163, 1200,
      1237, 1274, 1311, 1348, 1385, 1422, 1459, 1496, 1533, 1570, 1607, 1644,
      1681, 1718, 1755, 1792, 1829, 1866, 1903, 1940, 1977, 2014, 2051, 2088,
      2125, 2162, 2199, 2236, 2273, 2310, 2347, 2384, 2421, 2458, 2495, 2532,
      2569, 2606, 2643, 2680, 2717, 2754, 2791, 2828, 2865, 2902, 2939, 2976,
      3013, 3050, 3087, 3124, 3161, 3198, 3235, 3272,
    ],
    4050745,
    64,
  )
}

test clear_200_of_512_bytes_witness_is_the_executors() {
  cbor.serialise(clear_200_of_512_bytes_case().witness) == #""
