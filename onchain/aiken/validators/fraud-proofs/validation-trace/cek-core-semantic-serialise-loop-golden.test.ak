fn nested_128_deep_case() -> SerialiseCaseV1 {
  let pieces = [
    #"",
  ]
  case_of(
    data_value(
      DataSummaryV1 {
        root: #"cbed57ca7f9b1a6373b6ec9c748e9e6db12f5e0663de0a86fa5d46d33e1f1eff",
        cbor_length: 257,
        memory: 517,
      },
    ),
    bytes_result(pieces),
    pieces,
  )
}

