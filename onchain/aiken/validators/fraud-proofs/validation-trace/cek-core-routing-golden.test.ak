test semantic_group_routes() {
  list.all(
    [
      (0, 8), (1, 8), (2, 9), (3, 9), (4, 9), (5, 9), (6, 9), (7, 8), (8, 8),
      (9, 8), (10, 7), (11, 7), (12, 7), (13, 7), (14, 7), (15, 7), (16, 7),
      (17, 7), (18, 7), (19, 7), (20, 7), (21, 7), (22, 7), (23, 7), (24, 7),
      (25, 7), (29, 0), (30, 0), (31, 1), (32, 1), (33, 2), (34, 2), (35, 1),
      (36, 3), (37, 4), (39, 5), (40, 5), (41, 5), (42, 4), (44, 5), (45, 5),
      (46, 5), (47, 6), (48, 6), (49, 6), (50, 6), (51, 10), (53, 7), (71, 7),
      (72, 7), (73, 11), (74, 11), (75, 7), (76, 7), (77, 7), (78, 7), (79, 7),
      (80, 12), (82, 11), (83, 11), (84, 7), (85, 7), (86, 7),
