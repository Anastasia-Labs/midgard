-- executable test-midgard
--   import:         lang, dependencies
--   main-is:        Test.hs
--   other-modules:  Testing.Eval
--   hs-source-dirs: src, src/Testing
--   build-depends:  migdard-contracts

test-suite helpers-tests
  import:         lang, dependencies
  type:           exitcode-stdio-1.0
  main-is:        Test.hs

  -- The suite is ~2,600 independent Plutarch compilations and nothing in it
  -- shares mutable state, so tasty can run them across every core. Without
  -- -threaded it cannot, and the run is serial.
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  hs-source-dirs: tests
  other-modules:
    Testing.ActiveOperatorsValidator
