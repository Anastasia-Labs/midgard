#!/usr/bin/env bash

set -euo pipefail

if [[ "${MIDGARD_GRAPHIFY_SKIP_POST_COMMIT:-0}" == "1" ]]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
graphify_state_root="${MIDGARD_GRAPHIFY_STATE_ROOT:-/home/gumbo/.local/state/graphify/midgard-current}"

# A post-commit hook can run after a partial commit. Refuse to publish a graph
# from a mixture of HEAD and unrelated working-tree changes.
if [[ -n "$(git -C "$repo_root" status --porcelain --untracked-files=normal)" ]]; then
  echo "[midgard graphify] skipped: the post-commit checkout is not a coherent checkpoint" >&2
  echo "[midgard graphify] commit or stash the remaining changes, then run 'make refresh-graphify-graph'" >&2
  exit 0
fi

if ! command -v graphify >/dev/null 2>&1; then
  echo "[midgard graphify] graphify is not available on PATH; graph refresh skipped" >&2
  exit 0
fi

mkdir -p "$graphify_state_root"

echo "[midgard graphify] refreshing the external code graph for $(git -C "$repo_root" rev-parse --short HEAD)"
graphify extract "$repo_root" \
  --out "$graphify_state_root" \
  --code-only \
  --force \
  --max-workers 2 \
  --max-concurrency 1

indexed_commit="$(git -C "$repo_root" rev-parse HEAD)"
indexed_commit_file="$graphify_state_root/graphify-out/indexed-commit"
indexed_commit_tmp="$indexed_commit_file.tmp"
printf '%s\n' "$indexed_commit" >"$indexed_commit_tmp"
mv "$indexed_commit_tmp" "$indexed_commit_file"

echo "[midgard graphify] refreshed $graphify_state_root/graphify-out/graph.json at $indexed_commit"
