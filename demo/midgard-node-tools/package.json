{
  "name": "midgard-node-tools",
  "version": "1.0.0",
  "description": "End-to-end, stress, and acceptance tooling that drives a Midgard node from the outside; never part of the operator binary",
  "private": true,
  "type": "module",
  "bin": {
    "midgard-node-tools": "./dist/index.js"
  },
  "exports": {
    "./*": {
      "midgard-source": "./src/*.ts"
    }
  },
  "scripts": {
    "clean": "rimraf dist node_modules",
    "build": "tsup",
    "typecheck": "pnpm --dir ../lucid-midgard run build && pnpm --dir ../midgard-sdk run build && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format-check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "quick-test": "pnpm run build && node dist/index.js --help",
    "create-l2-wallet": "pnpm run build && node dist/index.js create-l2-wallet",
    "stress-wallets:prepare": "pnpm run build && node dist/index.js stress-wallets:prepare",
    "stress-wallets:fanout": "pnpm run build && node dist/index.js stress-wallets:fanout",
    "stress-corpus-generate": "pnpm run build && node dist/index.js stress-corpus-generate",
    "stress-corpus-verify": "pnpm run build && node dist/index.js stress-corpus-verify",
    "e2e-stress-l2-throughput": "pnpm run build && node dist/index.js e2e-stress-l2-throughput",
    "accept:phase4:pipelined-process": "node dist/index.js e2e-pipelined-commit-process-acceptance --node-root ../midgard-node",
    "verify:phase4:pipelined-process-summary": "node scripts/verify-phase4-pipelined-process-summary.mjs",
    "test:phase4:pipelined-process-summary-verifier": "node --test tests/phase4-pipelined-process-summary-verifier.test.mjs",
    "test:phase4:devnet-assets": "node --test devnet/phase4-process/tests/assets.test.mjs devnet/phase4-process/tests/custom-chain-config.test.mjs",
    "test:e2e-reliability": "export NODE_ENV='emulator' && vitest run tests/e2e-da-gates.test.ts tests/e2e-service-supervisor.test.ts tests/e2e-runner.test.ts tests/e2e-summary.test.ts --reporter=basic --disable-console-intercept",
    "test": "pnpm run test:phase4:pipelined-process-summary-verifier && pnpm run test:phase4:devnet-assets && export NODE_ENV='emulator' && vitest run -- --reporter=basic --disable-console-intercept"
  },
  "keywords": [
    "cardano",
    "layer2",
    "midgard",
    "anastasia-labs"
  ],
  "author": "Anastasia Labs",
  "license": "ISC",
  "dependencies": {
    "@aiken-lang/merkle-patricia-forestry": "github:Anastasia-Labs/merkle-patricia-forestry#b139785f7c118854f9824c26cc443e2df95cb50e&path:/off-chain",
    "@al-ft/lucid-midgard": "workspace:*",
    "@al-ft/midgard-core": "workspace:*",
    "@al-ft/midgard-fault-proofs": "workspace:*",
    "@al-ft/midgard-sdk": "workspace:*",
    "@al-ft/midgard-validation": "workspace:*",
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@effect/experimental": "^0.46.0",
    "@effect/opentelemetry": "^0.44.6",
    "@effect/platform": "^0.80.0",
    "@effect/platform-node": "^0.80.0",
    "@effect/sql": "^0.34.1",
    "@effect/sql-pg": "^0.35.1",
    "@harmoniclabs/bytestring": "1.0.0",
    "@harmoniclabs/cbor": "1.6.6",
    "@harmoniclabs/pair": "1.0.0",
    "@harmoniclabs/plutus-data": "1.2.6",
    "@harmoniclabs/plutus-machine": "2.1.3",
    "@harmoniclabs/uplc": "1.4.1",
    "@libp2p/bootstrap": "12.0.25",
    "@libp2p/crypto": "5.1.20",
    "@libp2p/gossipsub": "16.0.3",
    "@libp2p/identify": "4.1.8",
    "@libp2p/interface": "3.2.4",
    "@libp2p/peer-id": "6.0.11",
    "@libp2p/tcp": "11.0.22",
    "@lucid-evolution/lucid": "0.6.4",
    "@lucid-evolution/uplc": "0.2.23",
    "@multiformats/multiaddr": "13.0.3",
    "@noble/hashes": "^2.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-prometheus": "^0.57.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@opentelemetry/sdk-trace-web": "^1.30.1",
    "bip39": "^3.1.0",
    "blake2b": "2.1.4",
    "cborg": "^4.5.8",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "effect": "^3.14.22",
    "level": "^10.0.0",
    "libp2p": "3.3.4",
    "libsodium-wrappers-sumo": "0.7.15",
    "midgard-node": "workspace:*",
    "undici": "^7.25.0"
  },
  "devDependencies": {
    "@al-ft/midgard-test-support": "workspace:*",
    "@types/node": "^22.17.0",
    "da-committee-node": "workspace:*",
    "prettier": "^3.5.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
