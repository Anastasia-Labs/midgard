{
  "name": "midgard-watcher",
  "version": "0.1.0",
  "description": "Independent Midgard verifier and challenger service",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./tests/*": {
      "midgard-source": "./tests/*.ts"
    },
    ".": {
      "midgard-source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./native-chain-sync": {
      "midgard-source": "./src/l1/native-chain-sync.ts",
      "import": "./dist/l1/native-chain-sync.js"
    }
  },
  "bin": {
    "midgard-watcher": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "authority": "node dist/cli.js authority",
    "bench": "vitest run --config vitest.bench.config.ts",
    "build": "node ../../scripts/contrib.mjs build --package midgard-watcher",
    "clean": "rimraf dist",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" vitest.config.ts tsup.config.ts package.json tsconfig.json README.md",
    "format-check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" vitest.config.ts tsup.config.ts package.json tsconfig.json README.md",
    "lint": "eslint . --max-warnings=0",
    "replay": "env MALLOC_MMAP_THRESHOLD_=131072 node dist/cli.js replay",
    "start": "env MALLOC_MMAP_THRESHOLD_=131072 node dist/cli.js start",
    "test": "env MALLOC_MMAP_THRESHOLD_=131072 vitest run",
    "typecheck": "tsc --noEmit",
    "build:contrib-raw": "tsup src/index.ts src/cli.ts src/l1/native-chain-sync.ts --format esm"
  },
  "dependencies": {
    "@al-ft/l1-node-transport": "workspace:*",
    "@al-ft/midgard-core": "workspace:*",
    "@al-ft/midgard-fault-proofs": "workspace:*",
    "@al-ft/midgard-l1-follower": "workspace:*",
    "@al-ft/midgard-sdk": "workspace:*",
    "@al-ft/midgard-validation": "workspace:*",
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/peer-id": "6.0.11",
    "@libp2p/ping": "3.1.7",
    "@libp2p/tcp": "11.0.22",
    "@lucid-evolution/lucid": "0.6.7",
    "@lucid-evolution/scalus-uplc": "0.2.0",
    "@multiformats/multiaddr": "13.0.3",
    "@noble/hashes": "^2.0.1",
    "effect": "^3.14.22",
    "libp2p": "3.3.4"
  },
  "devDependencies": {
    "@aiken-lang/merkle-patricia-forestry": "github:Anastasia-Labs/merkle-patricia-forestry#b139785f7c118854f9824c26cc443e2df95cb50e&path:/off-chain",
    "@al-ft/midgard-test-support": "workspace:*",
    "@types/node": "^22.17.0",
    "esbuild": "0.25.0",
    "midgard-node": "workspace:*",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.16.0 <23"
  }
}
