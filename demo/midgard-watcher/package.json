{
  "name": "midgard-watcher",
  "version": "0.1.0",
  "description": "Independent Midgard verifier and challenger service",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "midgard-watcher": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "midgard-watcher-architecture.md",
    "watcher-plan-adversarial-review.md"
  ],
  "scripts": {
    "authority": "node dist/cli.js authority",
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "clean": "rimraf dist",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" vitest.config.ts package.json tsconfig.json README.md",
    "format-check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" vitest.config.ts package.json tsconfig.json README.md",
    "lint": "eslint . --max-warnings=0",
    "native:build": "mkdir -p dist/native && go -C native-chain-sync build -trimpath -o ../dist/native/midgard-chain-sync .",
    "native:test": "go -C native-chain-sync test ./...",
    "replay": "node dist/cli.js replay",
    "start": "node dist/cli.js start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@al-ft/midgard-core": "workspace:*",
    "@al-ft/midgard-fault-proofs": "workspace:*",
    "@al-ft/midgard-sdk": "workspace:*",
    "@al-ft/midgard-validation": "workspace:*",
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/peer-id": "6.0.11",
    "@libp2p/tcp": "11.0.22",
    "@lucid-evolution/lucid": "0.6.2",
    "@multiformats/multiaddr": "13.0.3",
    "libp2p": "3.3.4"
  },
  "devDependencies": {
    "@aiken-lang/merkle-patricia-forestry": "github:Anastasia-Labs/merkle-patricia-forestry#b139785f7c118854f9824c26cc443e2df95cb50e&path:/off-chain",
    "@types/node": "^22.17.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=22.16.0 <23"
  }
}
