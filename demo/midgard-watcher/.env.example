# Environment for compose.yaml. Copy to .env and point every path at a real
# host file or directory before `docker compose up -d`.
#
# Secret files: regular files (not symlinks), no trailing newline, each value
# distinct from every other secret. The two authentication keys are 32-byte
# lowercase hex; the bearer is 32 to 256 characters.

# --- Required: trusted-head authority only -----------------------------------
WATCHER_RECORD_KEY_FILE=/etc/midgard-watcher/secrets/record_key

# --- Required: both services (same bearer value) -----------------------------
WATCHER_BEARER_FILE=/etc/midgard-watcher/secrets/bearer

# --- Required: watcher `start` only ------------------------------------------
WATCHER_ROLLBACK_KEY_FILE=/etc/midgard-watcher/secrets/rollback_key
WATCHER_PROVER_KEY_FILE=/etc/midgard-watcher/secrets/prover_key
WATCHER_AVAILABILITY_KEY_FILE=/etc/midgard-watcher/secrets/availability_key

# --- Required: L1 stack ------------------------------------------------------
# Host directory holding the node config and the Shelley genesis the watcher
# config names under /cardano-config. See README.md for the public-network gap.
MIDGARD_L1_CONFIG_DIR=/etc/midgard-watcher/cardano-config

# --- Optional (compose defaults shown) ---------------------------------------
# Host directory holding node.socket.
# MIDGARD_L1_IPC_DIR=../midgard-node/cardano/ipc
# MIDGARD_WATCHER_IMAGE_TAG=local
# Healthcheck ports; keep equal to the ports of `endpoint` in authority.json
# and `operationsEndpoint` in watcher-process.json.
# WATCHER_AUTHORITY_PORT=7401
# WATCHER_OPERATIONS_PORT=7402
