{
  "name": "@al-ft/midgard-test-support",
  "version": "0.0.0",
  "private": true,
  "description": "Test-only helpers shared across the Midgard workspace.",
  "type": "module",
  "exports": {
    "./vitest": {
      "types": "./vitest.d.ts",
      "default": "./vitest.js"
    },
    "./hex": {
      "midgard-source": "./src/hex.ts",
      "types": "./src/hex.ts"
    },
    "./temp-files": {
      "midgard-source": "./src/temp-files.ts",
      "types": "./src/temp-files.ts"
    }
  },
  "files": [
    "src",
    "vitest.js",
    "vitest.d.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
