{
  "name": "@al-ft/midgard-user-cli",
  "version": "0.1.0",
  "private": true,
  "description": "midgard-user: a user's own Midgard deposits and withdrawals, submitted through the user's own L1 indexer",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "midgard-user": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "midgard-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/contrib.mjs build --package @al-ft/midgard-user-cli",
    "build:contrib-raw": "node ../scripts/package-tasks.mjs build",
    "clean": "rimraf dist",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" vitest.config.ts package.json tsconfig.json README.md",
    "format-check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" vitest.config.ts package.json tsconfig.json README.md",
    "lint": "eslint . --max-warnings=0",
    "test": "node ../scripts/package-test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "author": "Anastasia Labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anastasia-Labs/midgard.git",
    "directory": "demo/midgard-user-cli"
  },
  "dependencies": {
    "@al-ft/lucid-midgard": "workspace:*",
    "@al-ft/midgard-core": "workspace:*",
    "@al-ft/midgard-sdk": "workspace:*",
    "@lucid-evolution/lucid": "0.8.9",
    "commander": "^13.1.0",
    "effect": "^3.14.22"
  },
  "devDependencies": {
    "@al-ft/midgard-test-support": "workspace:*",
    "@types/node": "^22.17.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "midgardTasks": {
    "build": {
      "steps": [
        {
          "command": [
            "tsup",
            "src/index.ts",
            "src/cli.ts",
            "--format",
            "esm",
            "--dts",
            "--clean"
          ]
        }
      ],
      "outputs": [
        "dist"
      ]
    },
    "test": {
      "command": [
        "vitest",
        "run"
      ],
      "prerequisites": [
        {
          "kind": "build",
          "package": "@al-ft/midgard-core"
        },
        {
          "kind": "blueprint"
        }
      ]
    }
  }
}
