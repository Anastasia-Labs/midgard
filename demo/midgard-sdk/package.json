{
  "name": "@al-ft/midgard-sdk",
  "version": "0.1.0",
  "description": "Midgard TypeScript library for building operator and watcher transactions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "midgard-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./blueprint-abi": {
      "midgard-source": "./src/blueprint-abi/index.ts",
      "types": "./dist/blueprint-abi/index.d.ts",
      "import": "./dist/blueprint-abi/index.js",
      "require": "./dist/blueprint-abi/index.cjs"
    },
    "./core": {
      "midgard-source": "./src/layers/core.ts",
      "types": "./dist/layers/core.d.ts",
      "import": "./dist/layers/core.js"
    },
    "./state-queue": {
      "midgard-source": "./src/layers/state-queue.ts",
      "types": "./dist/layers/state-queue.d.ts",
      "import": "./dist/layers/state-queue.js"
    },
    "./da": {
      "midgard-source": "./src/layers/da.ts",
      "types": "./dist/layers/da.d.ts",
      "import": "./dist/layers/da.js"
    },
    "./operators": {
      "midgard-source": "./src/layers/operators.ts",
      "types": "./dist/layers/operators.d.ts",
      "import": "./dist/layers/operators.js"
    },
    "./users": {
      "midgard-source": "./src/layers/users.ts",
      "types": "./dist/layers/users.d.ts",
      "import": "./dist/layers/users.js"
    },
    "./deployment": {
      "midgard-source": "./src/layers/deployment.ts",
      "types": "./dist/layers/deployment.d.ts",
      "import": "./dist/layers/deployment.js"
    },
    "./fraud-proof": {
      "midgard-source": "./src/fraud-proof/index.ts",
      "types": "./dist/fraud-proof/index.d.ts",
      "import": "./dist/fraud-proof/index.js"
    },
    "./test-support/user-history": {
      "midgard-source": "./tests/support/user-history.ts",
      "types": "./tests/support/user-history.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./blueprint-abi": {
        "import": {
          "types": "./dist/blueprint-abi/index.d.ts",
          "default": "./dist/blueprint-abi/index.js"
        },
        "require": {
          "types": "./dist/blueprint-abi/index.d.cts",
          "default": "./dist/blueprint-abi/index.cjs"
        }
      },
      "./core": {
        "import": {
          "types": "./dist/layers/core.d.ts",
          "default": "./dist/layers/core.js"
        }
      },
      "./state-queue": {
        "import": {
          "types": "./dist/layers/state-queue.d.ts",
          "default": "./dist/layers/state-queue.js"
        }
      },
      "./da": {
        "import": {
          "types": "./dist/layers/da.d.ts",
          "default": "./dist/layers/da.js"
        }
      },
      "./operators": {
        "import": {
          "types": "./dist/layers/operators.d.ts",
          "default": "./dist/layers/operators.js"
        }
      },
      "./users": {
        "import": {
          "types": "./dist/layers/users.d.ts",
          "default": "./dist/layers/users.js"
        }
      },
      "./deployment": {
        "import": {
          "types": "./dist/layers/deployment.d.ts",
          "default": "./dist/layers/deployment.js"
        }
      },
      "./fraud-proof": {
        "import": {
          "types": "./dist/fraud-proof/index.d.ts",
          "default": "./dist/fraud-proof/index.js"
        }
      }
    }
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/.*"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "reset": "rimraf dist node_modules *.tgz",
    "build": "node ../../scripts/contrib.mjs build --package @al-ft/midgard-sdk",
    "fixtures:native-tx-carriage-wire-v1:sync": "pnpm run build && node scripts/generate-native-tx-carriage-wire-v1-goldens.mjs",
    "fixtures:native-tx-carriage-wire-v1:check": "pnpm run build && node scripts/generate-native-tx-carriage-wire-v1-goldens.mjs --check",
    "fixtures:canonical-decodability-v1:sync": "pnpm run build && node scripts/generate-canonical-decodability-v1-goldens.mjs",
    "fixtures:canonical-decodability-v1:check": "pnpm run build && node scripts/generate-canonical-decodability-v1-goldens.mjs --check",
    "fixtures:committed-field-shape-v1:sync": "pnpm run build && node scripts/generate-committed-field-shape-v1-goldens.mjs",
    "fixtures:committed-field-shape-v1:check": "pnpm run build && node scripts/generate-committed-field-shape-v1-goldens.mjs --check",
    "fixtures:da-commitment-v1:sync": "node scripts/generate-da-commitment-v1-goldens.mjs",
    "fixtures:da-commitment-v1:check": "node scripts/generate-da-commitment-v1-goldens.mjs --check",
    "fixtures:da-bond-pool-v1:sync": "node scripts/generate-da-bond-pool-v1-goldens.mjs",
    "fixtures:da-bond-pool-v1:check": "node scripts/generate-da-bond-pool-v1-goldens.mjs --check",
    "fixtures:da-attestation-capacity-v1:sync": "node scripts/generate-da-attestation-capacity-v1-fixture.mjs",
    "fixtures:da-attestation-capacity-v1:check": "node scripts/generate-da-attestation-capacity-v1-fixture.mjs --check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "repack": "pnpm run build  && pnpm pack",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format-check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "ts-node": "ts-node",
    "test": "node ../scripts/package-test.mjs",
    "build:contrib-raw": "node ../scripts/package-tasks.mjs build",
    "prepack": "node ../../scripts/release/pack-files.mjs copy",
    "postpack": "node ../../scripts/release/pack-files.mjs remove"
  },
  "keywords": [],
  "author": "Anastasia Labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anastasia-Labs/midgard.git",
    "directory": "demo/midgard-sdk"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@aiken-lang/merkle-patricia-forestry": "github:Anastasia-Labs/merkle-patricia-forestry#b139785f7c118854f9824c26cc443e2df95cb50e&path:/off-chain",
    "@al-ft/midgard-test-support": "workspace:*",
    "@effect/vitest": "^0.17.8",
    "@lucid-evolution/lucid": "0.8.9",
    "@sinclair/typebox": "^0.34.28",
    "@types/node": "^22.17.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "effect": "^3.14.22",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.5.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "typescript-5-8": "npm:typescript@5.8.3",
    "vitest": "5.0.3"
  },
  "directories": {
    "test": "test"
  },
  "dependencies": {
    "@al-ft/midgard-core": "workspace:*",
    "@lucid-evolution/uplc": "0.5.3",
    "@noble/hashes": "^2.0.1"
  },
  "peerDependencies": {
    "@lucid-evolution/lucid": "0.8.9",
    "effect": "^3.14.22"
  },
  "midgardTasks": {
    "build": {
      "steps": [
        {
          "command": [
            "tsup",
            "src/index.ts",
            "src/blueprint-abi/index.ts",
            "src/layers/core.ts",
            "src/layers/state-queue.ts",
            "src/layers/da.ts",
            "src/layers/operators.ts",
            "src/layers/users.ts",
            "src/layers/deployment.ts",
            "src/fraud-proof/index.ts",
            "--minify",
            "--format",
            "esm",
            "--dts",
            "--clean"
          ]
        },
        {
          "command": [
            "tsup",
            "src/index.ts",
            "src/blueprint-abi/index.ts",
            "--minify",
            "--format",
            "cjs"
          ]
        },
        {
          "command": [
            "node",
            "scripts/write-cjs-declarations.mjs"
          ]
        }
      ],
      "outputs": [
        "dist"
      ]
    },
    "test": {
      "command": [
        "vitest",
        "run"
      ],
      "prerequisites": [
        {
          "kind": "build",
          "package": "@al-ft/midgard-core"
        },
        {
          "kind": "blueprint"
        }
      ]
    }
  }
}
