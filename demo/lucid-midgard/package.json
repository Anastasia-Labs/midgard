{
  "name": "@al-ft/lucid-midgard",
  "version": "0.1.0",
  "description": "Midgard-native L2 transaction builder primitives inspired by lucid-evolution",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "!dist/.*"
  ],
  "exports": {
    ".": {
      "midgard-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "node ../../scripts/contrib.mjs build --package @al-ft/lucid-midgard",
    "fixtures:native-high-cardinality:sync": "MIDGARD_SYNC_FIXTURES=1 vitest run tests/native-high-cardinality-fixture.test.ts",
    "fixtures:native-size-balanced:sync": "MIDGARD_SYNC_FIXTURES=1 vitest run tests/native-size-balanced-fixture.test.ts",
    "fixtures:native-ordinary:sync": "MIDGARD_SYNC_FIXTURES=1 vitest run tests/native-ordinary-fixture.test.ts",
    "fixtures:native-compact": "node scripts/generate-native-compact-aiken-goldens.mjs",
    "fixtures:native-compact:check": "node scripts/generate-native-compact-aiken-goldens.mjs --check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "node ../scripts/package-test.mjs",
    "build:contrib-raw": "node ../scripts/package-tasks.mjs build",
    "prepack": "node ../../scripts/release/pack-files.mjs copy",
    "postpack": "node ../../scripts/release/pack-files.mjs remove"
  },
  "keywords": [
    "cardano",
    "layer2",
    "midgard",
    "transaction-builder"
  ],
  "author": "Anastasia Labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anastasia-Labs/midgard.git",
    "directory": "demo/lucid-midgard"
  },
  "dependencies": {
    "@al-ft/midgard-core": "workspace:*",
    "@al-ft/midgard-validation": "workspace:*",
    "@noble/hashes": "^2.0.1",
    "effect": "^3.14.22"
  },
  "peerDependencies": {
    "@lucid-evolution/lucid": "0.8.5"
  },
  "devDependencies": {
    "@al-ft/midgard-test-support": "workspace:*",
    "@lucid-evolution/lucid": "0.8.5",
    "@types/node": "^22.17.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "midgardTasks": {
    "build": {
      "steps": [
        {
          "command": [
            "tsup",
            "src/index.ts",
            "--format",
            "esm,cjs",
            "--dts",
            "--clean"
          ]
        }
      ],
      "outputs": [
        "dist"
      ],
      "prerequisites": [
        {
          "kind": "build",
          "package": "@al-ft/midgard-validation"
        }
      ]
    },
    "test": {
      "command": [
        "vitest",
        "run"
      ],
      "prerequisites": [
        {
          "kind": "build",
          "package": "@al-ft/midgard-core"
        },
        {
          "kind": "blueprint"
        }
      ]
    }
  }
}
