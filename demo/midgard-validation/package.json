{
  "name": "@al-ft/midgard-validation",
  "version": "0.1.0",
  "description": "Shared Midgard native transaction validation pipeline",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ledger": {
      "types": "./dist/ledger.d.ts",
      "import": "./dist/ledger.js",
      "require": "./dist/ledger.cjs"
    },
    "./ledger-tx": {
      "types": "./dist/ledger-tx.d.ts",
      "import": "./dist/ledger-tx.js",
      "require": "./dist/ledger-tx.cjs"
    },
    "./ledger-tx/codec": {
      "types": "./dist/ledger-tx/codec.d.ts",
      "import": "./dist/ledger-tx/codec.js",
      "require": "./dist/ledger-tx/codec.cjs"
    },
    "./ledger-tx/types": {
      "types": "./dist/ledger-tx/types.d.ts",
      "import": "./dist/ledger-tx/types.js",
      "require": "./dist/ledger-tx/types.cjs"
    },
    "./local-script-eval": {
      "types": "./dist/local-script-eval.d.ts",
      "import": "./dist/local-script-eval.js",
      "require": "./dist/local-script-eval.cjs"
    },
    "./cek-program": {
      "types": "./dist/cek-program.d.ts",
      "import": "./dist/cek-program.js",
      "require": "./dist/cek-program.cjs"
    },
    "./cek-machine": {
      "types": "./dist/cek-machine.d.ts",
      "import": "./dist/cek-machine.js",
      "require": "./dist/cek-machine.cjs"
    },
    "./cek-executor": {
      "types": "./dist/cek-executor.d.ts",
      "import": "./dist/cek-executor.js",
      "require": "./dist/cek-executor.cjs"
    },
    "./cek-builtin": {
      "types": "./dist/cek-builtin.d.ts",
      "import": "./dist/cek-builtin.js",
      "require": "./dist/cek-builtin.cjs"
    },
    "./cek-data": {
      "types": "./dist/cek-data.d.ts",
      "import": "./dist/cek-data.js",
      "require": "./dist/cek-data.cjs"
    },
    "./cek-data-tree": {
      "types": "./dist/cek-data-tree.d.ts",
      "import": "./dist/cek-data-tree.js",
      "require": "./dist/cek-data-tree.cjs"
    },
    "./cek-constant": {
      "types": "./dist/cek-constant.d.ts",
      "import": "./dist/cek-constant.js",
      "require": "./dist/cek-constant.cjs"
    },
    "./midgard-redeemers": {
      "types": "./dist/midgard-redeemers.d.ts",
      "import": "./dist/midgard-redeemers.js",
      "require": "./dist/midgard-redeemers.cjs"
    },
    "./phase-a": {
      "types": "./dist/phase-a.d.ts",
      "import": "./dist/phase-a.js",
      "require": "./dist/phase-a.cjs"
    },
    "./phase-b": {
      "types": "./dist/phase-b.d.ts",
      "import": "./dist/phase-b.js",
      "require": "./dist/phase-b.cjs"
    },
    "./plutus-data": {
      "types": "./dist/plutus-data.d.ts",
      "import": "./dist/plutus-data.js",
      "require": "./dist/plutus-data.cjs"
    },
    "./script-context": {
      "types": "./dist/script-context.d.ts",
      "import": "./dist/script-context.js",
      "require": "./dist/script-context.cjs"
    },
    "./script-context-proof": {
      "types": "./dist/script-context-proof.d.ts",
      "import": "./dist/script-context-proof.js",
      "require": "./dist/script-context-proof.cjs"
    },
    "./script-source": {
      "types": "./dist/script-source.d.ts",
      "import": "./dist/script-source.js",
      "require": "./dist/script-source.cjs"
    },
    "./tx-out-ref": {
      "types": "./dist/tx-out-ref.d.ts",
      "import": "./dist/tx-out-ref.js",
      "require": "./dist/tx-out-ref.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "pnpm --dir ../midgard-core run build",
    "build": "tsup src/index.ts src/cek-builtin.ts src/cek-constant.ts src/cek-data-tree.ts src/cek-data.ts src/cek-executor.ts src/cek-machine.ts src/cek-program.ts src/ledger.ts src/ledger-output-descriptor.ts src/ledger-tx.ts src/ledger-tx/codec.ts src/ledger-tx/types.ts src/local-script-eval.ts src/midgard-redeemers.ts src/phase-a.ts src/phase-b.ts src/plutus-data.ts src/script-context.ts src/script-context-proof.ts src/script-source.ts src/tx-out-ref.ts src/types.ts src/validation-dispute-evidence.ts src/validation-machine.ts --format esm,cjs --dts --clean",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "fixtures:ordered-collection-boundary-aiken:sync": "pnpm run build && node scripts/generate-ordered-collection-boundary-aiken-goldens.mjs",
    "fixtures:ordered-collection-boundary-aiken:check": "pnpm run build && node scripts/generate-ordered-collection-boundary-aiken-goldens.mjs --check",
    "test": "vitest run",
    "test:cardano-capability-p2:data-breadth": "NODE_OPTIONS=--max-old-space-size=4096 node scripts/verify-goal-cardano-capability-p2-data-breadth.mjs"
  },
  "keywords": [
    "cardano",
    "layer2",
    "midgard",
    "validation"
  ],
  "author": "Anastasia Labs",
  "license": "ISC",
  "dependencies": {
    "@aiken-lang/merkle-patricia-forestry": "github:Anastasia-Labs/merkle-patricia-forestry#b139785f7c118854f9824c26cc443e2df95cb50e&path:/off-chain",
    "@al-ft/midgard-core": "workspace:*",
    "@harmoniclabs/cardano-costmodels-ts": "1.4.0",
    "@harmoniclabs/cbor": "1.6.6",
    "@harmoniclabs/plutus-data": "1.2.6",
    "@harmoniclabs/plutus-machine": "2.1.3",
    "@harmoniclabs/uplc": "1.4.1",
    "@lucid-evolution/lucid": "0.6.2",
    "@noble/hashes": "^2.0.1",
    "effect": "^3.14.22"
  },
  "devDependencies": {
    "@al-ft/midgard-sdk": "workspace:*",
    "@types/node": "^22.17.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
