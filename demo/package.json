{
  "name": "midgard-demo",
  "private": true,
  "scripts": {
    "deployment:generate": "node scripts/deployment-profiles.mjs generate",
    "deployment:check": "node scripts/deployment-profiles.mjs check",
    "deployment:build": "node scripts/deployment-profiles.mjs build",
    "build": "node scripts/deployment-profiles.mjs check && pnpm -r --if-present --workspace-concurrency=4 run build",
    "bench:aiken:native-tx-decoders": "node ../onchain/aiken/scripts/native-tx-decoder-benchmark-report.mjs",
    "lint": "node scripts/lint-by-package.mjs",
    "lint:fix": "node scripts/lint-by-package.mjs --fix",
    "typecheck": "pnpm -r --if-present --workspace-concurrency=4 run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format-check": "prettier --check \"**/*.{ts,tsx,md}\" \"!**/.architecture-f-wasm/**\" \"!**/coverage/**\" \"!**/deploymentInfo/**\" \"!**/dist/**\" \"!**/logs/**\" \"!**/node_modules/**\"",
    "hooks:install": "bash ../.githooks/install",
    "test:tx-prep:sdk": "pnpm --filter @al-ft/lucid-midgard test && pnpm --filter @al-ft/midgard-sdk test",
    "test:tx-prep:node": "pnpm --filter midgard-node run test:tx-prep:node && pnpm --filter midgard-node-tools run test:e2e-reliability",
    "test:tx-prep:emulator": "pnpm --filter midgard-node run test:tx-prep:emulator && pnpm --filter @al-ft/midgard-fault-proofs exec vitest run --pool=forks tests/submit-init-emulator",
    "test:tx-prep:local": "pnpm run test:tx-prep:sdk && pnpm run test:tx-prep:node && pnpm run test:tx-prep:emulator",
    "fixtures:transaction-root-v1": "pnpm --dir midgard-node run fixtures:transaction-root-v1",
    "fixtures:transaction-root-v1:check": "pnpm --dir midgard-node run fixtures:transaction-root-v1:check",
    "test": "node scripts/run-test-lanes-v1.mjs",
    "test:serial": "pnpm run typecheck && pnpm -r --if-present --workspace-concurrency=1 run test",
    "clean": "pnpm -r --if-present --workspace-concurrency=1 run clean && rm -rf node_modules",
    "install-sdk": "pnpm --filter midgard-sdk install",
    "repack-sdk": "pnpm --filter midgard-sdk repack"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.15.0",
    "prettier": "^3.5.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^5.0.3",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
