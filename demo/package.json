{
  "name": "midgard-demo",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present --workspace-concurrency=4 run build",
    "bench:aiken:native-tx-decoders": "node ../onchain/aiken/scripts/native-tx-decoder-benchmark-report.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r --if-present --workspace-concurrency=4 run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format-check": "prettier --check \"**/*.{ts,tsx,md}\" \"!**/.architecture-f-wasm/**\" \"!**/coverage/**\" \"!**/deploymentInfo/**\" \"!**/dist/**\" \"!**/logs/**\" \"!**/node_modules/**\"",
    "hooks:install": "bash ../.githooks/install",
    "test:tx-prep:sdk": "pnpm --filter @al-ft/lucid-midgard test && pnpm --filter @al-ft/midgard-sdk test",
    "test:tx-prep:node": "pnpm --filter midgard-node run test:tx-prep:node",
    "test:tx-prep:emulator": "pnpm --filter midgard-node run test:tx-prep:emulator && pnpm --filter @al-ft/midgard-fault-proofs exec vitest run --pool=forks --no-file-parallelism tests/submit-init-emulator",
    "test:tx-prep:local": "pnpm run test:tx-prep:sdk && pnpm run test:tx-prep:node && pnpm run test:tx-prep:emulator",
    "fixtures:transaction-root-v1": "pnpm --dir midgard-node run fixtures:transaction-root-v1",
    "fixtures:transaction-root-v1:check": "pnpm --dir midgard-node run fixtures:transaction-root-v1:check",
    "watcher:dependency-map:verify": "node scripts/verify-canonical-v1-watcher-dependency-map.mjs",
    "watcher:focused-tests:verify": "node scripts/verify-canonical-v1-watcher-focused-tests.mjs",
    "test": "node scripts/run-test-lanes-v1.mjs",
    "test:serial": "pnpm run typecheck && pnpm -r --if-present --workspace-concurrency=1 run test",
    "clean": "pnpm -r --if-present --workspace-concurrency=1 run clean && rm -rf node_modules",
    "install-sdk": "pnpm --filter midgard-sdk install",
    "repack-sdk": "pnpm --filter midgard-sdk repack"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.5.2",
    "vitest": "^1.3.1",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0",
  "pnpm": {
    "patchedDependencies": {
      "blake2b@2.1.4": "patches/blake2b@2.1.4.patch"
    },
    "overrides": {
      "@anastasia-labs/cardano-multiplatform-lib-nodejs@6.2.0-1": "6.2.0-2",
      "@anastasia-labs/cardano-multiplatform-lib-browser@6.2.0-1": "6.2.0-2"
    }
  }
}
