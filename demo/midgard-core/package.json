  "license": "ISC",
  "dependencies": {
    "@lucid-evolution/lucid": "0.6.0",
    "@noble/hashes": "^2.0.1",
    "cborg": "^4.5.8"
  },
  "devDependencies": {
    "@harmoniclabs/cardano-costmodels-ts": "1.4.0",
    "@types/node": "^22.17.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
