    "docs:consensus-profile-v1:sync": "pnpm run build && node scripts/sync-consensus-profile-doc-v1.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
