{
  "name": "@al-ft/midgard-ts",
  "version": "0.1.0",
  "description": "Pure TypeScript port of the Midgard binary codec",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cardano": {
      "types": "./dist/cardano.d.ts",
      "import": "./dist/cardano.js",
      "require": "./dist/cardano.cjs"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js",
      "require": "./dist/validation/index.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup src/index.ts src/cardano.ts src/validation/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": [
    "cardano",
    "layer2",
    "midgard",
    "codec"
  ],
  "author": "Anastasia Labs",
  "license": "ISC",
  "dependencies": {
    "@dcspark/cardano-multiplatform-lib-nodejs": "^6.2.0",
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.17.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
