# Benchmark-profile defaults for scripts/throughput-valid-stress.mjs.
# Copy or pass with STRESS_ENV_FILE; point corpus/node/no-op paths at the run.

STRESS_MODE=ramp
STRESS_MAX_CHAINS=auto
STRESS_CORPUS_SHAPE=fanout
STRESS_CORPUS_READAHEAD_ROWS=50

STRESS_REQUIRE_NOOP_CALIBRATION=true
STRESS_CALIBRATION_HEADROOM_MULTIPLIER=2
STRESS_CALIBRATION_DURATION_SEC=5
STRESS_NODE_SATURATION_MIN_RATIO=1.2

STRESS_SUBMIT_CONCURRENCY=from-calibration
STRESS_HTTP_CONNECTIONS=from-calibration
STRESS_HTTP_PIPELINING=1
STRESS_RETRY_503=0
STRESS_MEASURED_RETRY_503=0

STRESS_CLIENT_SELF_CHECK=true
STRESS_CLIENT_SELF_CHECK_REQUIRED=true
STRESS_CLIENT_SELF_CHECK_MULTIPLIER=2

STRESS_RAMP_START_TPS=100
STRESS_RAMP_STEP_TPS=100
STRESS_RAMP_MAX_TPS=2500
STRESS_RAMP_STAGE_SEC=15
STRESS_RAMP_MIN_ACCEPTED_RATIO=0.99

STRESS_OFFERED_RATE_MIN_RATIO=0.98
STRESS_ACCEPTED_RATE_MIN_RATIO=0.99
STRESS_SCHEDULE_LAG_P95_MAX_MS=100
STRESS_SCHEDULE_LAG_P99_MAX_MS=250
STRESS_SUBMIT_LATENCY_P99_MAX_MS=1000
STRESS_MISSED_START_MAX_RATIO=0.001
STRESS_BACKLOG_SLOPE_MAX_PER_SEC=0.1
