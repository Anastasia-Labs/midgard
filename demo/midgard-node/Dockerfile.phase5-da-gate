# syntax=docker/dockerfile:1.7

FROM node:22.22.2-bookworm-slim

RUN corepack enable
WORKDIR /workspace/demo
COPY . .
RUN --mount=type=cache,id=phase5-da-pnpm,target=/root/.local/share/pnpm/store \
  pnpm install --frozen-lockfile
RUN pnpm --filter midgard-node... --workspace-concurrency=1 run build

WORKDIR /workspace/demo/midgard-node
ENV NODE_ENV=emulator
CMD ["pnpm", "run", "gate:phase5:da-50k-distribution"]
