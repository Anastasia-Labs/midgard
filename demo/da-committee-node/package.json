{
  "name": "midgard-watcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "midgard-watcher": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "guard:no-http-da-transport": "node scripts/check-no-http-da-transport.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "clean": "rimraf dist node_modules"
  },
  "dependencies": {
    "@aiken-lang/merkle-patricia-forestry": "github:Anastasia-Labs/merkle-patricia-forestry#b139785f7c118854f9824c26cc443e2df95cb50e&path:/off-chain",
    "@al-ft/midgard-core": "workspace:*",
    "@al-ft/midgard-sdk": "workspace:*",
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/bootstrap": "12.0.25",
    "@libp2p/crypto": "5.1.20",
    "@libp2p/gossipsub": "16.0.3",
    "@libp2p/identify": "4.1.8",
    "@libp2p/interface": "3.2.4",
    "@libp2p/peer-id": "6.0.11",
    "@libp2p/tcp": "11.0.22",
    "@lucid-evolution/lucid": "0.5.6",
    "@lucid-evolution/scalus-uplc": "0.1.2",
    "@multiformats/multiaddr": "13.0.3",
