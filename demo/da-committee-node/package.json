{
  "name": "da-committee-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "da-committee-node": "./dist/index.js",
    "midgard-public-retained-da": "./dist/public-retained-da.js"
  },
  "exports": {
    "./config": {
      "midgard-source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./store": {
      "midgard-source": "./src/store.ts",
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./da/libp2p": {
      "midgard-source": "./src/da/libp2p/index.ts",
      "types": "./dist/da/libp2p/index.d.ts",
      "import": "./dist/da/libp2p/index.js"
    },
    "./da/libp2p/DaStreamCodec": {
      "midgard-source": "./src/da/libp2p/DaStreamCodec.ts",
      "types": "./dist/da/libp2p/DaStreamCodec.d.ts",
      "import": "./dist/da/libp2p/DaStreamCodec.js"
    },
    "./l1/state-queue-scanner": {
      "midgard-source": "./src/l1/state-queue-scanner.ts",
      "types": "./dist/l1/state-queue-scanner.d.ts",
      "import": "./dist/l1/state-queue-scanner.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/public-retained-da.ts src/config.ts src/store.ts src/da/libp2p/index.ts src/da/libp2p/DaStreamCodec.ts src/l1/state-queue-scanner.ts --format esm --dts --clean",
    "guard:no-http-da-transport": "node scripts/check-no-http-da-transport.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "clean": "rimraf dist node_modules"
  },
  "dependencies": {
    "@aiken-lang/merkle-patricia-forestry": "github:Anastasia-Labs/merkle-patricia-forestry#b139785f7c118854f9824c26cc443e2df95cb50e&path:/off-chain",
    "@al-ft/midgard-core": "workspace:*",
    "@al-ft/midgard-sdk": "workspace:*",
    "@al-ft/midgard-validation": "workspace:*",
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/bootstrap": "12.0.25",
    "@libp2p/crypto": "5.1.20",
    "@libp2p/gossipsub": "16.0.3",
    "@libp2p/identify": "4.1.8",
    "@libp2p/interface": "3.2.4",
    "@libp2p/peer-id": "6.0.11",
    "@libp2p/tcp": "11.0.22",
    "@lucid-evolution/lucid": "0.6.4",
    "@lucid-evolution/scalus-uplc": "0.1.3",
    "@multiformats/multiaddr": "13.0.3",
    "@noble/hashes": "^2.0.1",
    "effect": "^3.14.22",
    "libp2p": "3.3.4",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@al-ft/midgard-test-support": "workspace:*",
    "@types/node": "^22.17.0",
    "@types/pg": "^8.20.0",
    "midgard-watcher": "workspace:*",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
